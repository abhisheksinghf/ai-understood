---
import BookLayout from '../../layouts/BookLayout.astro';
import Chapter, {getHeadings} from '../../content/chapter-40.mdx';
import raw from '../../content/chapter-40.mdx?raw';
const headings=getHeadings();
const chunks=raw.split(/^## /m).slice(1);
const searchSections=headings.filter(h=>h.depth===2).map((h,i)=>({title:h.text,slug:h.slug,body:(chunks[i]||'').split('\n').slice(1).join(' ').replace(/<[^>]+>/g,' ').replace(/[`*#|]/g,'').replace(/\s+/g,' ').trim()}));
const words=raw.replace(/<[^>]+>/g,' ').split(/\s+/).filter(Boolean).length;
---
<BookLayout title="Graphs, causality, and alternative learning methods" chapter chapterNumber={40} headings={headings} searchSections={searchSections} tocTitles={["Graph foundations","Message passing","Knowledge graphs","Observation & intervention","Fair comparisons","Sources of supervision","Other learning methods","Choosing a method","Python workbook","Connections lab","Knowledge check","Revision & next steps"]} searchPlaceholder="Try “causality”, “entropy”, or “federated”…">
  <div class="breadcrumb"><a href="/curriculum/">Handbook</a><span>/</span><span>Part 10 · Broader AI &amp; your capstone</span></div>
  <header class="chapter-hero">
    <div class="hero-kicker"><span class="chapter-pill">CHAPTER 40</span><span class="edition">CONNECT · COMPARE · QUERY</span></div>
    <h1>Relationships change the question.<br/><em>Follow the connections.</em></h1>
    <p class="hero-description">Understand graphs, causal comparisons, and new learning setups,<br class="desktop-break"/> through connected movie examples.</p>
    <div class="chapter-meta"><span><i aria-hidden="true">◷</i> 15–20 min core reading</span><span>20–30 min practice</span><span>12 short sections</span></div>
    <div class="hero-actions screen-only"><a href="#1-represent-relationships-with-graphs" class="primary-button">Start learning <span>↓</span></a><a class="text-button" href="/downloads/ai-handbook-chapter-40.pdf" download>Download PDF <span>↗</span></a><button class="text-button" id="print-chapter">Print chapter</button></div>
    <div class="hero-illustration" aria-hidden="true"><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="orbit orbit-three"></div><span class="orbit-node n1"></span><span class="orbit-node n2"></span><span class="orbit-node n3"></span><span class="orbit-label">CONNECT → COMPARE → QUERY → EVALUATE</span></div>
  </header>
  <div class="reader-tools screen-only"><button id="save-place" class="small-button">Bookmark this section</button><a id="resume-place" hidden>Resume saved section →</a><details class="reader-options"><summary>More reading tools</summary><div class="reader-tools-inner"><span class="local-note">Progress is saved in this browser.</span><div class="backup-actions"><button id="export-progress" class="small-button">Export progress</button><label class="small-button" for="import-progress">Import progress<input id="import-progress" type="file" accept="application/json"/></label></div></div></details></div>
  <div class="chapter-content"><Chapter /></div>
  <section class="completion-card screen-only" aria-labelledby="completion-title"><span class="eyebrow">PAUSE. EXPLAIN. CONNECT.</span><h2 id="completion-title">Can you explain the claim each method supports?</h2><p>Trace a graph update, explain a reversed comparison, and distinguish selecting labels from improving a model.</p><button id="complete-chapter" class="primary-button" aria-pressed="false">Mark Chapter 40 complete</button><p id="completion-status" class="local-note">Your completion status is saved only in this browser.</p></section>
  <footer class="chapter-end"><div><span class="eyebrow">NEXT IN THE HANDBOOK</span><h3>AI research, AGI, and keeping your knowledge current</h3><p>Read research critically, assess capability claims, and build a sustainable learning practice.</p><a class="text-button" href="/chapters/39-vision-recommendations-and-time-series-applications/">← Revisit Chapter 39</a></div><a class="primary-button" href="/chapters/41-ai-research-agi-and-keeping-your-knowledge-current/">Read Chapter 41 →</a></footer>
  <div class="edition-footer">AI, understood · Personal learning edition · Chapter 40 · About {(Math.round(words/100)*100).toLocaleString()} words</div>
</BookLayout>
