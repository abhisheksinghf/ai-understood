---
import BookLayout from '../../layouts/BookLayout.astro';
import Chapter, {getHeadings} from '../../content/chapter-16.mdx';
import raw from '../../content/chapter-16.mdx?raw';
const headings=getHeadings();
const chunks=raw.split(/^## /m).slice(1);
const searchSections=headings.filter(h=>h.depth===2).map((h,i)=>({title:h.text,slug:h.slug,body:(chunks[i]||'').split('\n').slice(1).join(' ').replace(/<[^>]+>/g,' ').replace(/[`*#|]/g,'').replace(/\s+/g,' ').trim()}));
const words=raw.replace(/<[^>]+>/g,' ').split(/\s+/).filter(Boolean).length;
---
<BookLayout title="Information retrieval: how search works" chapter chapterNumber={16} headings={headings} searchSections={searchSections} tocTitles={["Start with a need","Analyze the text","Build an inverted index","Match, filter & rank","Term overlap & TF-IDF","Understand BM25","Why keyword search misses","Evaluate the results","Try the search explorer","Python & practice","Knowledge check","Connect to embeddings & RAG"]} searchPlaceholder="Try “BM25”, “posting”, or “relevance”…">
  <div class="breadcrumb"><a href="/curriculum/">Handbook</a><span>/</span><span>Part 05 · Search, embeddings &amp; RAG</span></div>
  <header class="chapter-hero">
    <div class="hero-kicker"><span class="chapter-pill">CHAPTER 16</span><span class="edition">FIND THE WORDS · UNDERSTAND THE RESULTS</span></div>
    <h1>How search works.<br/><em>From words to results.</em></h1>
    <p class="hero-description">Build an index. Explain a ranking.<br class="desktop-break"/> Find out why matching words can still miss the meaning.</p>
    <div class="chapter-meta"><span><i aria-hidden="true">◷</i> 16–20 min core reading</span><span>20–30 min practice</span><span>12 short sections</span></div>
    <div class="hero-actions screen-only"><a href="#1-start-with-an-information-need" class="primary-button">Start learning <span>↓</span></a><a class="text-button" href="/downloads/ai-handbook-chapter-16.pdf" download>Download PDF <span>↗</span></a><button class="text-button" id="print-chapter">Print chapter</button></div>
    <div class="hero-illustration" aria-hidden="true"><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="orbit orbit-three"></div><span class="orbit-node n1"></span><span class="orbit-node n2"></span><span class="orbit-node n3"></span><span class="orbit-label">INDEX → MATCH → RANK</span></div>
  </header>
  <div class="reader-tools screen-only"><button id="save-place" class="small-button">Bookmark this section</button><a id="resume-place" hidden>Resume saved section →</a><details class="reader-options"><summary>More reading tools</summary><div class="reader-tools-inner"><span class="local-note">Progress is saved in this browser.</span><div class="backup-actions"><button id="export-progress" class="small-button">Export progress</button><label class="small-button" for="import-progress">Import progress<input id="import-progress" type="file" accept="application/json"/></label></div></div></details></div>
  <div class="chapter-content"><Chapter /></div>
  <section class="completion-card screen-only" aria-labelledby="completion-title"><span class="eyebrow">PAUSE. EXPLAIN. CONNECT.</span><h2 id="completion-title">Can you explain why a movie appeared in the results?</h2><p>Trace the query through its postings, eligibility, and score. Then judge whether the returned movies actually answer the intent.</p><button id="complete-chapter" class="primary-button" aria-pressed="false">Mark Chapter 16 complete</button><p id="completion-status" class="local-note">Your completion status is saved only in this browser.</p></section>
  <footer class="chapter-end"><div><span class="eyebrow">NEXT IN THE HANDBOOK</span><h3>Embeddings and vector search</h3><p>Represent meaning numerically and search beyond shared words.</p><a class="text-button" href="/chapters/15-evaluating-and-improving-ml-models/">← Revisit Chapter 15</a></div><a class="primary-button" href="/chapters/17-embeddings-and-vector-search/">Read Chapter 17 <span>→</span></a></footer>
  <div class="edition-footer">AI, understood · Personal learning edition · Chapter 16 · About {(Math.round(words/100)*100).toLocaleString()} words</div>
</BookLayout>
