---
import BookLayout from '../../layouts/BookLayout.astro';
import Chapter, {getHeadings} from '../../content/chapter-19.mdx';
import raw from '../../content/chapter-19.mdx?raw';
const headings=getHeadings();
const chunks=raw.split(/^## /m).slice(1);
const searchSections=headings.filter(h=>h.depth===2).map((h,i)=>({title:h.text,slug:h.slug,body:(chunks[i]||'').split('\n').slice(1).join(' ').replace(/<[^>]+>/g,' ').replace(/[`*#|]/g,'').replace(/\s+/g,' ').trim()}));
const words=raw.replace(/<[^>]+>/g,' ').split(/\s+/).filter(Boolean).length;
---
<BookLayout title="Improving and evaluating RAG" chapter chapterNumber={19} headings={headings} searchSections={searchSections} tocTitles={["Define success","Build reference cases","Retrieval & context","Answer & citation quality","Answer or abstain?","Choose a grader","Target the failure","Compare fairly","Try the workbench","Python & practice","Knowledge check","Keep evaluating"]} searchPlaceholder="Try “faithfulness”, “abstention”, or “leakage”…">
  <div class="breadcrumb"><a href="/curriculum/">Handbook</a><span>/</span><span>Part 05 · Search, embeddings &amp; RAG</span></div>
  <header class="chapter-hero">
    <div class="hero-kicker"><span class="chapter-pill">CHAPTER 19</span><span class="edition">MEASURE QUALITY · TEST THE CHANGE</span></div>
    <h1>Improve and evaluate RAG.<br/><em>Measure what matters.</em></h1>
    <p class="hero-description">Separate retrieval, answer quality, and citation support.<br class="desktop-break"/> Diagnose failures and compare improvements fairly.</p>
    <div class="chapter-meta"><span><i aria-hidden="true">◷</i> 18–22 min core reading</span><span>25–35 min practice</span><span>12 short sections</span></div>
    <div class="hero-actions screen-only"><a href="#1-define-success-before-choosing-a-metric" class="primary-button">Start learning <span>↓</span></a><a class="text-button" href="/downloads/ai-handbook-chapter-19.pdf" download>Download PDF <span>↗</span></a><button class="text-button" id="print-chapter">Print chapter</button></div>
    <div class="hero-illustration" aria-hidden="true"><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="orbit orbit-three"></div><span class="orbit-node n1"></span><span class="orbit-node n2"></span><span class="orbit-node n3"></span><span class="orbit-label">MEASURE → DIAGNOSE → IMPROVE</span></div>
  </header>
  <div class="reader-tools screen-only"><button id="save-place" class="small-button">Bookmark this section</button><a id="resume-place" hidden>Resume saved section →</a><details class="reader-options"><summary>More reading tools</summary><div class="reader-tools-inner"><span class="local-note">Progress is saved in this browser.</span><div class="backup-actions"><button id="export-progress" class="small-button">Export progress</button><label class="small-button" for="import-progress">Import progress<input id="import-progress" type="file" accept="application/json"/></label></div></div></details></div>
  <div class="chapter-content"><Chapter /></div>
  <section class="completion-card screen-only" aria-labelledby="completion-title"><span class="eyebrow">PAUSE. EXPLAIN. CONNECT.</span><h2 id="completion-title">Can you explain the gain and the regression?</h2><p>Name the failure stage, state the metric and denominator, and inspect what worsened before accepting a change.</p><button id="complete-chapter" class="primary-button" aria-pressed="false">Mark Chapter 19 complete</button><p id="completion-status" class="local-note">Your completion status is saved only in this browser.</p></section>
  <footer class="chapter-end"><div><span class="eyebrow">NEXT IN THE HANDBOOK</span><h3>Neural networks from first principles</h3><p>Open the learned model: layers, activations, losses, and parameter updates.</p><a class="text-button" href="/chapters/18-building-a-rag-system-step-by-step/">← Revisit Chapter 18</a></div><a class="primary-button" href="/chapters/20-neural-networks-from-first-principles/">Read Chapter 20 →</a></footer>
  <div class="edition-footer">AI, understood · Personal learning edition · Chapter 19 · About {(Math.round(words/100)*100).toLocaleString()} words</div>
</BookLayout>
