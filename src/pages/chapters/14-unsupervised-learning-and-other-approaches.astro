---
import BookLayout from '../../layouts/BookLayout.astro';
import Chapter, {getHeadings} from '../../content/chapter-14.mdx';
import raw from '../../content/chapter-14.mdx?raw';
const headings=getHeadings();
const chunks=raw.split(/^## /m).slice(1);
const searchSections=headings.filter(h=>h.depth===2).map((h,i)=>({title:h.text,slug:h.slug,body:(chunks[i]||'').split('\n').slice(1).join(' ').replace(/<[^>]+>/g,' ').replace(/[`*#|]/g,'').replace(/\s+/g,' ').trim()}));
const words=raw.replace(/<[^>]+>/g,' ').split(/\s+/).filter(Boolean).length;
---
<BookLayout title="Unsupervised learning and other learning approaches" chapter chapterNumber={14} headings={headings} searchSections={searchSections} tocTitles={["Structure without labels","Define similarity","The k-means loop","Interpret the groups","Compress with PCA","Inspect unusual records","Learning signals","Other learning approaches","Try the structure explorer","Python & practice","Knowledge check","Revision & connections"]} searchPlaceholder="Try “centroid”, “PCA”, or “pseudo-label”…">
  <div class="breadcrumb"><a href="/curriculum/">Handbook</a><span>/</span><span>Part 04 · Data &amp; classical machine learning</span></div>
  <header class="chapter-hero">
    <div class="hero-kicker"><span class="chapter-pill">CHAPTER 14</span><span class="edition">DISCOVER STRUCTURE · UNDERSTAND THE SIGNAL</span></div>
    <h1>Unsupervised learning.<br/><em>Structure without labels.</em></h1>
    <p class="hero-description">Group similar movies. Keep fewer coordinates.<br class="desktop-break"/> Understand what the discovered patterns tell you.</p>
    <div class="chapter-meta"><span><i aria-hidden="true">◷</i> 16–20 min core reading</span><span>20–30 min practice</span><span>12 short sections</span></div>
    <div class="hero-actions screen-only"><a href="#1-look-for-structure-without-supplied-outcome-labels" class="primary-button">Start learning <span>↓</span></a><a class="text-button" href="/downloads/ai-handbook-chapter-14.pdf" download>Download PDF <span>↗</span></a><button class="text-button" id="print-chapter">Print chapter</button></div>
    <div class="hero-illustration" aria-hidden="true"><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="orbit orbit-three"></div><span class="orbit-node n1"></span><span class="orbit-node n2"></span><span class="orbit-node n3"></span><span class="orbit-label">REPRESENT → FIT → INTERPRET</span></div>
  </header>
  <div class="reader-tools screen-only"><button id="save-place" class="small-button">Bookmark this section</button><a id="resume-place" hidden>Resume saved section →</a><details class="reader-options"><summary>More reading tools</summary><div class="reader-tools-inner"><span class="local-note">Progress is saved in this browser.</span><div class="backup-actions"><button id="export-progress" class="small-button">Export progress</button><label class="small-button" for="import-progress">Import progress<input id="import-progress" type="file" accept="application/json"/></label></div></div></details></div>
  <div class="chapter-content"><Chapter /></div>
  <section class="completion-card screen-only" aria-labelledby="completion-title"><span class="eyebrow">PAUSE. EXPLAIN. CONNECT.</span><h2 id="completion-title">Can you explain the structure without overstating it?</h2><p>Trace a centroid update, reconstruct a PCA point, and explain where different learning approaches get their signal.</p><button id="complete-chapter" class="primary-button" aria-pressed="false">Mark Chapter 14 complete</button><p id="completion-status" class="local-note">Your completion status is saved only in this browser.</p></section>
  <footer class="chapter-end"><div><span class="eyebrow">NEXT IN THE HANDBOOK</span><h3>Evaluating and improving ML models</h3><p>Choose useful metrics, compare models fairly, and learn from their errors.</p><a class="text-button" href="/chapters/13-supervised-learning-regression-and-classification/">← Revisit Chapter 13</a></div><a class="primary-button" href="/chapters/15-evaluating-and-improving-ml-models/">Read Chapter 15 <span>→</span></a></footer>
  <div class="edition-footer">AI, understood · Personal learning edition · Chapter 14 · About {(Math.round(words/100)*100).toLocaleString()} words</div>
</BookLayout>
