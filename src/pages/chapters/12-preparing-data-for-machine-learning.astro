---
import BookLayout from '../../layouts/BookLayout.astro';
import Chapter, {getHeadings} from '../../content/chapter-12.mdx';
import raw from '../../content/chapter-12.mdx?raw';
const headings=getHeadings();
const chunks=raw.split(/^## /m).slice(1);
const searchSections=headings.filter(h=>h.depth===2).map((h,i)=>({title:h.text,slug:h.slug,body:(chunks[i]||'').split('\n').slice(1).join(' ').replace(/<[^>]+>/g,' ').replace(/[`*#|]/g,'').replace(/\s+/g,' ').trim()}));
const words=raw.replace(/<[^>]+>/g,' ').split(/\s+/).filter(Boolean).length;
---
<BookLayout title="Preparing data for machine learning" chapter chapterNumber={12} headings={headings} searchSections={searchSections} tocTitles={["Define a row & target","Inspect the raw data","Duplicates & cleaning","Choose the right split","Handle missing values","Encoding & scaling","Fit versus transform","Try the workbench","Run the Python workbook","Practice exercises","Knowledge check","Revision & connections"]} searchPlaceholder="Try “sampling bias”, “imputation”, or “leakage”…">
  <div class="breadcrumb"><a href="/curriculum/">Handbook</a><span>/</span><span>Part 04 · Data &amp; classical machine learning</span></div>
  <header class="chapter-hero">
    <div class="hero-kicker"><span class="chapter-pill">CHAPTER 12</span><span class="edition">GOOD INPUTS · HONEST EVALUATION</span></div>
    <h1>Prepare data<br/><em>for machine learning.</em></h1>
    <p class="hero-description">Give every row a meaning.<br class="desktop-break"/> Turn messy records into inputs you can trust.</p>
    <div class="chapter-meta"><span><i aria-hidden="true">◷</i> 18–22 min core reading</span><span>20–30 min practice</span><span>12 short sections</span></div>
    <div class="hero-actions screen-only"><a href="#1-decide-what-one-row-means" class="primary-button">Start learning <span>↓</span></a><a class="text-button" href="/downloads/ai-handbook-chapter-12.pdf" download>Download PDF <span>↗</span></a><button class="text-button" id="print-chapter">Print chapter</button></div>
    <div class="hero-illustration" aria-hidden="true"><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="orbit orbit-three"></div><span class="orbit-node n1"></span><span class="orbit-node n2"></span><span class="orbit-node n3"></span><span class="orbit-label">CHECK → SPLIT → TRANSFORM</span></div>
  </header>
  <div class="reader-tools screen-only"><button id="save-place" class="small-button">Bookmark this section</button><a id="resume-place" hidden>Resume saved section →</a><details class="reader-options"><summary>More reading tools</summary><div class="reader-tools-inner"><span class="local-note">Progress is saved in this browser.</span><div class="backup-actions"><button id="export-progress" class="small-button">Export progress</button><label class="small-button" for="import-progress">Import progress<input id="import-progress" type="file" accept="application/json"/></label></div></div></details></div>
  <div class="chapter-content"><Chapter /></div>
  <section class="completion-card screen-only" aria-labelledby="completion-title"><span class="eyebrow">PAUSE. EXPLAIN. CONNECT.</span><h2 id="completion-title">Can you prepare an honest training table?</h2><p>Define the prediction boundary, explain the split, calculate a fill value, and show why held-out data cannot change training preparation.</p><button id="complete-chapter" class="primary-button" aria-pressed="false">Mark Chapter 12 complete</button><p id="completion-status" class="local-note">Your completion status is saved only in this browser.</p></section>
  <footer class="chapter-end"><div><span class="eyebrow">NEXT IN THE HANDBOOK</span><h3>Supervised learning: regression and classification</h3><p>Learn numerical predictions and classes from prepared examples.</p><a class="text-button" href="/chapters/11-project-movie-recommendation-assistant/">← Revisit Chapter 11</a></div><a class="primary-button" href="/chapters/13-supervised-learning-regression-and-classification/">Read Chapter 13 <span>→</span></a></footer>
  <div class="edition-footer">AI, understood · Personal learning edition · Chapter 12 · About {(Math.round(words/100)*100).toLocaleString()} words</div>
</BookLayout>
