---
import BookLayout from '../../layouts/BookLayout.astro';
import Chapter, {getHeadings} from '../../content/chapter-11.mdx';
import raw from '../../content/chapter-11.mdx?raw';
const headings=getHeadings();
const chunks=raw.split(/^## /m).slice(1);
const searchSections=headings.filter(h=>h.depth===2).map((h,i)=>({title:h.text,slug:h.slug,body:(chunks[i]||'').split('\n').slice(1).join(' ').replace(/<[^>]+>/g,' ').replace(/[`*#|]/g,'').replace(/\s+/g,' ').trim()}));
const words=raw.replace(/<[^>]+>/g,' ').split(/\s+/).filter(Boolean).length;
---
<BookLayout title="Project 1: a movie recommendation assistant" chapter chapterNumber={11} headings={headings} searchSections={searchSections} tocTitles={["The product promise","Catalog & preferences","Hard constraints","Ranking & tie-breaks","Try the movie assistant","Run the Python project","The optional LLM stage","Handle empty results","Evaluate the product","Practice exercises","Knowledge check","Revision & connections"]} searchPlaceholder="Try “cold start”, “tie-break”, or “graceful degradation”…">
  <div class="breadcrumb"><a href="/curriculum/">Handbook</a><span>/</span><span>Part 03 · Your first LLM application</span></div>
  <header class="chapter-hero">
    <div class="hero-kicker"><span class="chapter-pill">CHAPTER 11</span><span class="edition">PROJECT 01 · PUT THE PIECES TOGETHER</span></div>
    <h1>Build your movie<br/><em>recommendation assistant.</em></h1>
    <p class="hero-description">Choose a movie. Explain the choice.<br class="desktop-break"/> Build a small product you can inspect and test.</p>
    <div class="chapter-meta"><span><i aria-hidden="true">◷</i> 15–20 min core reading</span><span>30–45 min project practice</span><span>12 short sections</span></div>
    <div class="hero-actions screen-only"><a href="#1-start-with-a-small-product-promise" class="primary-button">Start learning <span>↓</span></a><a class="text-button" href="/downloads/ai-handbook-chapter-11.pdf" download>Download PDF <span>↗</span></a><button class="text-button" id="print-chapter">Print chapter</button></div>
    <div class="hero-illustration" aria-hidden="true"><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="orbit orbit-three"></div><span class="orbit-node n1"></span><span class="orbit-node n2"></span><span class="orbit-node n3"></span><span class="orbit-label">FILTER → RANK → EXPLAIN</span></div>
  </header>
  <div class="reader-tools screen-only"><button id="save-place" class="small-button">Bookmark this section</button><a id="resume-place" hidden>Resume saved section →</a><details class="reader-options"><summary>More reading tools</summary><div class="reader-tools-inner"><span class="local-note">Progress is saved in this browser.</span><div class="backup-actions"><button id="export-progress" class="small-button">Export progress</button><label class="small-button" for="import-progress">Import progress<input id="import-progress" type="file" accept="application/json"/></label></div></div></details></div>
  <div class="chapter-content"><Chapter /></div>
  <section class="completion-card screen-only" aria-labelledby="completion-title"><span class="eyebrow">PAUSE. EXPLAIN. CONNECT.</span><h2 id="completion-title">Can you trace a recommendation?</h2><p>Explain the filters, predict the ranking, inspect an unsupported draft, and show which tests establish which guarantees.</p><button id="complete-chapter" class="primary-button" aria-pressed="false">Mark Chapter 11 complete</button><p id="completion-status" class="local-note">Your completion status is saved only in this browser.</p></section>
  <footer class="chapter-end"><div><span class="eyebrow">NEXT IN THE HANDBOOK</span><h3>Preparing data for machine learning</h3><p>Inspect, clean, and split data before fitting a model.</p><a class="text-button" href="/chapters/10-building-an-llm-application-with-python/">← Revisit Chapter 10</a></div><a class="primary-button" href="/chapters/12-preparing-data-for-machine-learning/">Read Chapter 12 <span>→</span></a></footer>
  <div class="edition-footer">AI, understood · Personal learning edition · Chapter 11 · About {(Math.round(words/100)*100).toLocaleString()} words</div>
</BookLayout>
