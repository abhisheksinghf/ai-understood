---
import BookLayout from '../../layouts/BookLayout.astro';
import Chapter, {getHeadings} from '../../content/chapter-13.mdx';
import raw from '../../content/chapter-13.mdx?raw';
const headings=getHeadings();
const chunks=raw.split(/^## /m).slice(1);
const searchSections=headings.filter(h=>h.depth===2).map((h,i)=>({title:h.text,slug:h.slug,body:(chunks[i]||'').split('\n').slice(1).join(' ').replace(/<[^>]+>/g,' ').replace(/[`*#|]/g,'').replace(/\s+/g,' ').trim()}));
const words=raw.replace(/<[^>]+>/g,' ').split(/\s+/).filter(Boolean).length;
---
<BookLayout title="Supervised learning: regression and classification" chapter chapterNumber={13} headings={headings} searchSections={searchSections} tocTitles={["Choose the target","Inputs & labels","Fit a regression line","Measure numeric errors","Logistic probabilities","Classification loss","Decision thresholds","Flexibility & model families","Try the model explorer","Python & practice","Knowledge check","Revision & connections"]} searchPlaceholder="Try “calibration”, “logit”, or “regularization”…">
  <div class="breadcrumb"><a href="/curriculum/">Handbook</a><span>/</span><span>Part 04 · Data &amp; classical machine learning</span></div>
  <header class="chapter-hero">
    <div class="hero-kicker"><span class="chapter-pill">CHAPTER 13</span><span class="edition">LEARN FROM EXAMPLES · INSPECT THE RESULT</span></div>
    <h1>Supervised learning.<br/><em>Numbers and classes.</em></h1>
    <p class="hero-description">Predict a rating. Estimate a thumbs-up.<br class="desktop-break"/> Learn what changes when the target changes.</p>
    <div class="chapter-meta"><span><i aria-hidden="true">◷</i> 18–22 min core reading</span><span>20–30 min practice</span><span>12 short sections</span></div>
    <div class="hero-actions screen-only"><a href="#1-start-with-the-outcome-you-want-to-predict" class="primary-button">Start learning <span>↓</span></a><a class="text-button" href="/downloads/ai-handbook-chapter-13.pdf" download>Download PDF <span>↗</span></a><button class="text-button" id="print-chapter">Print chapter</button></div>
    <div class="hero-illustration" aria-hidden="true"><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="orbit orbit-three"></div><span class="orbit-node n1"></span><span class="orbit-node n2"></span><span class="orbit-node n3"></span><span class="orbit-label">FIT → PREDICT → DECIDE</span></div>
  </header>
  <div class="reader-tools screen-only"><button id="save-place" class="small-button">Bookmark this section</button><a id="resume-place" hidden>Resume saved section →</a><details class="reader-options"><summary>More reading tools</summary><div class="reader-tools-inner"><span class="local-note">Progress is saved in this browser.</span><div class="backup-actions"><button id="export-progress" class="small-button">Export progress</button><label class="small-button" for="import-progress">Import progress<input id="import-progress" type="file" accept="application/json"/></label></div></div></details></div>
  <div class="chapter-content"><Chapter /></div>
  <section class="completion-card screen-only" aria-labelledby="completion-title"><span class="eyebrow">PAUSE. EXPLAIN. CONNECT.</span><h2 id="completion-title">Can you separate the prediction from the decision?</h2><p>Trace a rating and a probability, compare their losses, and explain which controls change the model and which change its decision.</p><button id="complete-chapter" class="primary-button" aria-pressed="false">Mark Chapter 13 complete</button><p id="completion-status" class="local-note">Your completion status is saved only in this browser.</p></section>
  <footer class="chapter-end"><div><span class="eyebrow">NEXT IN THE HANDBOOK</span><h3>Unsupervised learning and other learning approaches</h3><p>Discover structure and compare different learning signals.</p><a class="text-button" href="/chapters/12-preparing-data-for-machine-learning/">← Revisit Chapter 12</a></div><a class="primary-button" href="/chapters/14-unsupervised-learning-and-other-approaches/">Read Chapter 14 <span>→</span></a></footer>
  <div class="edition-footer">AI, understood · Personal learning edition · Chapter 13 · About {(Math.round(words/100)*100).toLocaleString()} words</div>
</BookLayout>
