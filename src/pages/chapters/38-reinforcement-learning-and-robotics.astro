---
import BookLayout from '../../layouts/BookLayout.astro';
import Chapter, {getHeadings} from '../../content/chapter-38.mdx';
import raw from '../../content/chapter-38.mdx?raw';
const headings=getHeadings();
const chunks=raw.split(/^## /m).slice(1);
const searchSections=headings.filter(h=>h.depth===2).map((h,i)=>({title:h.text,slug:h.slug,body:(chunks[i]||'').split('\n').slice(1).join(' ').replace(/<[^>]+>/g,' ').replace(/[`*#|]/g,'').replace(/\s+/g,' ').trim()}));
const words=raw.replace(/<[^>]+>/g,' ').split(/\s+/).filter(Boolean).length;
---
<BookLayout title="Reinforcement learning and robotics" chapter chapterNumber={38} headings={headings} searchSections={searchSections} tocTitles={["Action & feedback","States & returns","Rewards & credit","Explore or exploit","Q-learning updates","The algorithm families","Evaluate the policy","Robotics & control","Python workbook","Reinforcement lab","Knowledge check","Revision & next steps"]} searchPlaceholder="Try “reward”, “exploration”, or “robot”…">
  <div class="breadcrumb"><a href="/curriculum/">Handbook</a><span>/</span><span>Part 10 · Broader AI &amp; your capstone</span></div>
  <header class="chapter-hero">
    <div class="hero-kicker"><span class="chapter-pill">CHAPTER 38</span><span class="edition">ACT · LEARN · IMPROVE</span></div>
    <h1>Actions have consequences.<br/><em>Learn from experience.</em></h1>
    <p class="hero-description">Understand reinforcement learning and robotics,<br class="desktop-break"/> from delayed rewards to reliable physical actions.</p>
    <div class="chapter-meta"><span><i aria-hidden="true">◷</i> 15–20 min core reading</span><span>20–30 min practice</span><span>12 short sections</span></div>
    <div class="hero-actions screen-only"><a href="#1-learn-through-an-action-and-feedback-loop" class="primary-button">Start learning <span>↓</span></a><a class="text-button" href="/downloads/ai-handbook-chapter-38.pdf" download>Download PDF <span>↗</span></a><button class="text-button" id="print-chapter">Print chapter</button></div>
    <div class="hero-illustration" aria-hidden="true"><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="orbit orbit-three"></div><span class="orbit-node n1"></span><span class="orbit-node n2"></span><span class="orbit-node n3"></span><span class="orbit-label">OBSERVE → ACT → RECEIVE REWARD → LEARN</span></div>
  </header>
  <div class="reader-tools screen-only"><button id="save-place" class="small-button">Bookmark this section</button><a id="resume-place" hidden>Resume saved section →</a><details class="reader-options"><summary>More reading tools</summary><div class="reader-tools-inner"><span class="local-note">Progress is saved in this browser.</span><div class="backup-actions"><button id="export-progress" class="small-button">Export progress</button><label class="small-button" for="import-progress">Import progress<input id="import-progress" type="file" accept="application/json"/></label></div></div></details></div>
  <div class="chapter-content"><Chapter /></div>
  <section class="completion-card screen-only" aria-labelledby="completion-title"><span class="eyebrow">PAUSE. EXPLAIN. CONNECT.</span><h2 id="completion-title">Can you explain what the agent has learned?</h2><p>Calculate a return and a Q update, explain exploration, and distinguish a successful simulation from reliable robot behavior.</p><button id="complete-chapter" class="primary-button" aria-pressed="false">Mark Chapter 38 complete</button><p id="completion-status" class="local-note">Your completion status is saved only in this browser.</p></section>
  <footer class="chapter-end"><div><span class="eyebrow">NEXT IN THE HANDBOOK</span><h3>Vision, recommendations, and time-series applications</h3><p>Connect the methods you have learned to practical application designs and their evaluation.</p><a class="text-button" href="/chapters/37-classical-symbolic-and-probabilistic-ai/">← Revisit Chapter 37</a></div><a class="primary-button" href="/chapters/39-vision-recommendations-and-time-series-applications/">Read Chapter 39 →</a></footer>
  <div class="edition-footer">AI, understood · Personal learning edition · Chapter 38 · About {(Math.round(words/100)*100).toLocaleString()} words</div>
</BookLayout>
