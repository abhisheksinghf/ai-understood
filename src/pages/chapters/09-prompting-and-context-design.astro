---
import BookLayout from '../../layouts/BookLayout.astro';
import Chapter, { getHeadings } from '../../content/chapter-09.mdx';
import raw from '../../content/chapter-09.mdx?raw';
const headings=getHeadings();
const chunks=raw.split(/^## /m).slice(1);
const searchSections=headings.filter(h=>h.depth===2).map((h,i)=>({title:h.text,slug:h.slug,body:(chunks[i]||'').split('\n').slice(1).join(' ').replace(/<[^>]+>/g,' ').replace(/[`*#|]/g,'').replace(/\s+/g,' ').trim()}));
const words=raw.replace(/<[^>]+>/g,' ').split(/\s+/).filter(Boolean).length;
---
<BookLayout title="Prompting and context design" chapter chapterNumber={9} headings={headings} searchSections={searchSections} tocTitles={["Define the task","Assemble the input","Instructions & authority","Evidence & unknowns","Examples & demonstrations","Output contracts","Prompt workshop","Context budget","Evaluation & boundaries","Practice exercises","Knowledge check","Revision & connections"]} searchPlaceholder="Try “few-shot”, “provenance”, or “prompt injection”…">
  <div class="breadcrumb"><a href="/curriculum/">Handbook</a><span>/</span><span>Part 03 · Your first LLM application</span></div>
  <header class="chapter-hero">
    <div class="hero-kicker"><span class="chapter-pill">CHAPTER 09</span><span class="edition">FROM A REQUEST TO A CHECKABLE RESULT</span></div>
    <h1>Prompting &amp;<br/><em>context design.</em></h1>
    <p class="hero-description">Make the task clear. Choose useful evidence.<br class="desktop-break"/> Build prompts whose results you can check.</p>
    <div class="chapter-meta"><span><i aria-hidden="true">◷</i> 20–25 min core reading</span><span>No API key needed</span><span>12 short sections</span></div>
    <div class="hero-actions screen-only"><a href="#1-define-the-task-before-writing-the-prompt" class="primary-button">Start learning <span>↓</span></a><a class="text-button" href="/downloads/ai-handbook-chapter-09.pdf" download>Download PDF <span>↗</span></a><button class="text-button" id="print-chapter">Print chapter</button></div>
    <div class="hero-illustration" aria-hidden="true"><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="orbit orbit-three"></div><span class="orbit-node n1"></span><span class="orbit-node n2"></span><span class="orbit-node n3"></span><span class="orbit-label">NAME → CALCULATE → INTERPRET</span></div>
  </header>
  <div class="reader-tools screen-only"><button id="save-place" class="small-button">Bookmark this section</button><a id="resume-place" hidden>Resume saved section →</a><details class="reader-options"><summary>More reading tools</summary><div class="reader-tools-inner"><span class="local-note">Progress is saved in this browser.</span><div class="backup-actions"><button id="export-progress" class="small-button">Export progress</button><label class="small-button" for="import-progress">Import progress<input id="import-progress" type="file" accept="application/json"/></label></div></div></details></div>
  <div class="chapter-content"><Chapter /></div>
  <section class="completion-card screen-only" aria-labelledby="completion-title"><span class="eyebrow">PAUSE. EXPLAIN. CONNECT.</span><h2 id="completion-title">Can you explain it in your own words?</h2><p>Write a testable prompt, preserve unknown streaming availability, and explain why valid JSON can still contain an unsupported claim. Use the workshop to inspect the difference.</p><button id="complete-chapter" class="primary-button" aria-pressed="false">Mark Chapter 9 complete</button><p id="completion-status" class="local-note">Your completion status is saved only in this browser.</p></section>
  <footer class="chapter-end"><div><span class="eyebrow">NEXT IN THE HANDBOOK</span><h3>Building an LLM application with Python</h3><p>Connect instructions, model calls, response validation, and application behavior.</p><a class="text-button" href="/chapters/08-calculus-optimization-and-information/">← Revisit Chapter 8</a></div><a class="primary-button" href="/chapters/10-building-an-llm-application-with-python/">Read Chapter 10 →</a></footer>
  <div class="edition-footer">AI, understood · Personal learning edition · Chapter 09 · About {(Math.round(words/100)*100).toLocaleString()} words</div>
</BookLayout>
