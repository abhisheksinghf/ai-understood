---
import BookLayout from '../../layouts/BookLayout.astro';
import Chapter, {getHeadings} from '../../content/chapter-25.mdx';
import raw from '../../content/chapter-25.mdx?raw';
const headings=getHeadings();
const chunks=raw.split(/^## /m).slice(1);
const searchSections=headings.filter(h=>h.depth===2).map((h,i)=>({title:h.text,slug:h.slug,body:(chunks[i]||'').split('\n').slice(1).join(' ').replace(/<[^>]+>/g,' ').replace(/[`*#|]/g,'').replace(/\s+/g,' ').trim()}));
const words=raw.replace(/<[^>]+>/g,' ').split(/\s+/).filter(Boolean).length;
---
<BookLayout title="How LLMs are trained and generate text" chapter chapterNumber={25} headings={headings} searchSections={searchSections} tocTitles={["Training vs inference","Prepare the data","Next-token objective","Training runs","Instruction tuning","Choose loss targets","Learn preferences","Format & generate","Decode & evaluate","Explore & practice","Knowledge check","Toward efficient systems"]} searchPlaceholder="Try “loss mask”, “SFT”, or “prefill”…">
  <div class="breadcrumb"><a href="/curriculum/">Handbook</a><span>/</span><span>Part 06 · Deep learning &amp; LLM internals</span></div>
  <header class="chapter-hero">
    <div class="hero-kicker"><span class="chapter-pill">CHAPTER 25</span><span class="edition">PRETRAIN · ADAPT · GENERATE</span></div>
    <h1>Learn from examples.<br/><em>Generate with fixed weights.</em></h1>
    <p class="hero-description">Connect data and training to assistant behavior,<br class="desktop-break"/> then trace how a checkpoint generates a reply.</p>
    <div class="chapter-meta"><span><i aria-hidden="true">◷</i> 20–25 min core reading</span><span>20–30 min practice</span><span>12 short sections</span></div>
    <div class="hero-actions screen-only"><a href="#1-separate-training-from-using-the-model" class="primary-button">Start learning <span>↓</span></a><a class="text-button" href="/downloads/ai-handbook-chapter-25.pdf" download>Download PDF <span>↗</span></a><button class="text-button" id="print-chapter">Print chapter</button></div>
    <div class="hero-illustration" aria-hidden="true"><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="orbit orbit-three"></div><span class="orbit-node n1"></span><span class="orbit-node n2"></span><span class="orbit-node n3"></span><span class="orbit-label">PRETRAIN → ADAPT → GENERATE</span></div>
  </header>
  <div class="reader-tools screen-only"><button id="save-place" class="small-button">Bookmark this section</button><a id="resume-place" hidden>Resume saved section →</a><details class="reader-options"><summary>More reading tools</summary><div class="reader-tools-inner"><span class="local-note">Progress is saved in this browser.</span><div class="backup-actions"><button id="export-progress" class="small-button">Export progress</button><label class="small-button" for="import-progress">Import progress<input id="import-progress" type="file" accept="application/json"/></label></div></div></details></div>
  <div class="chapter-content"><Chapter /></div>
  <section class="completion-card screen-only" aria-labelledby="completion-title"><span class="eyebrow">PAUSE. EXPLAIN. CONNECT.</span><h2 id="completion-title">Can you explain what changes when a model learns?</h2><p>Distinguish pretraining, SFT, and preferences; then trace a generated reply without updating weights.</p><button id="complete-chapter" class="primary-button" aria-pressed="false">Mark Chapter 25 complete</button><p id="completion-status" class="local-note">Your completion status is saved only in this browser.</p></section>
  <footer class="chapter-end"><div><span class="eyebrow">NEXT IN THE HANDBOOK</span><h3>Efficient and advanced LLM systems</h3><p>Understand memory, computation, and the choices that make LLM systems practical.</p><a class="text-button" href="/chapters/24-attention-and-transformers-explained/">← Revisit Chapter 24</a></div><a class="primary-button" href="/chapters/26-efficient-and-advanced-llm-systems/">Read Chapter 26 →</a></footer>
  <div class="edition-footer">AI, understood · Personal learning edition · Chapter 25 · About {(Math.round(words/100)*100).toLocaleString()} words</div>
</BookLayout>
