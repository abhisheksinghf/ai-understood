---
import BookLayout from '../../layouts/BookLayout.astro';
import Chapter, { getHeadings } from '../../content/chapter-04.mdx';
import raw from '../../content/chapter-04.mdx?raw';
const headings=getHeadings();
const chunks=raw.split(/^## /m).slice(1);
const searchSections=headings.filter(h=>h.depth===2).map((h,i)=>({title:h.text,slug:h.slug,body:(chunks[i]||'').split('\n').slice(1).join(' ').replace(/<[^>]+>/g,' ').replace(/[`*#|]/g,'').replace(/\s+/g,' ').trim()}));
const words=raw.replace(/<[^>]+>/g,' ').split(/\s+/).filter(Boolean).length;
---
<BookLayout title="Python for AI" chapter chapterNumber={4} headings={headings} searchSections={searchSections} tocTitles={["Run your first script","Values, names & types","Lists & dictionaries","Conditions & loops","Reusable functions","Trace the loop","Imports & environments","Files & errors","Build the evaluator","Practice exercises","Knowledge check","Revision & sources"]} searchPlaceholder="Try “dictionary”, “return”, or “virtual environment”…">
  <div class="breadcrumb"><a href="/curriculum/">Handbook</a><span>/</span><span>Part 02 · Programming foundations</span></div>
  <header class="chapter-hero">
    <div class="hero-kicker"><span class="chapter-pill">CHAPTER 04</span><span class="edition">TURN IDEAS INTO WORKING CODE</span></div>
    <h1>Python<br/><em>for AI.</em></h1>
    <p class="hero-description">Read the code. Follow the values.<br class="desktop-break"/> Build a small program you can explain and test.</p>
    <div class="chapter-meta"><span><i aria-hidden="true">◷</i> 25–30 min core reading</span><span>Beginner friendly</span><span>12 short sections</span></div>
    <div class="hero-actions screen-only"><a href="#1-write-a-file-run-it-with-python" class="primary-button">Start learning <span>↓</span></a><a class="text-button" href="/downloads/ai-handbook-chapter-04.pdf" download>Download PDF <span>↗</span></a><button class="text-button" id="print-chapter">Print chapter</button></div>
    <div class="hero-illustration" aria-hidden="true"><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="orbit orbit-three"></div><span class="orbit-node n1"></span><span class="orbit-node n2"></span><span class="orbit-node n3"></span><span class="orbit-label">READ → CALCULATE → CHECK</span></div>
  </header>
  <div class="reader-tools screen-only"><button id="save-place" class="small-button">Bookmark this section</button><a id="resume-place" hidden>Resume saved section →</a><details class="reader-options"><summary>More reading tools</summary><div class="reader-tools-inner"><span class="local-note">Progress is saved in this browser.</span><div class="backup-actions"><button id="export-progress" class="small-button">Export progress</button><label class="small-button" for="import-progress">Import progress<input id="import-progress" type="file" accept="application/json"/></label></div></div></details></div>
  <div class="chapter-content"><Chapter /></div>
  <section class="completion-card screen-only" aria-labelledby="completion-title"><span class="eyebrow">PAUSE. EXPLAIN. CONNECT.</span><h2 id="completion-title">Can you explain it in your own words?</h2><p>Run the starter, change a data point, and explain the new result. Check that you can trace the loop and distinguish printing from returning.</p><button id="complete-chapter" class="primary-button" aria-pressed="false">Mark Chapter 4 complete</button><p id="completion-status" class="local-note">Your completion status is saved only in this browser.</p></section>
  <footer class="chapter-end"><div><span class="eyebrow">NEXT IN THE HANDBOOK</span><h3>Software, APIs, and data fundamentals</h3><p>Connect your Python programs to files, services, and structured data.</p><a class="text-button" href="/chapters/03-how-models-learn/">← Revisit Chapter 3</a></div><a class="primary-button" href="/chapters/05-software-apis-and-data/">Read Chapter 5 <span>→</span></a></footer>
  <div class="edition-footer">AI, understood · Personal learning edition · Chapter 04 · About {(Math.round(words/100)*100).toLocaleString()} words</div>
</BookLayout>
