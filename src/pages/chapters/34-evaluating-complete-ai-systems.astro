---
import BookLayout from '../../layouts/BookLayout.astro';
import Chapter, {getHeadings} from '../../content/chapter-34.mdx';
import raw from '../../content/chapter-34.mdx?raw';
const headings=getHeadings();
const chunks=raw.split(/^## /m).slice(1);
const searchSections=headings.filter(h=>h.depth===2).map((h,i)=>({title:h.text,slug:h.slug,body:(chunks[i]||'').split('\n').slice(1).join(' ').replace(/<[^>]+>/g,' ').replace(/[`*#|]/g,'').replace(/\s+/g,' ').trim()}));
const words=raw.replace(/<[^>]+>/g,' ').split(/\s+/).filter(Boolean).length;
---
<BookLayout title="Evaluating complete AI systems" chapter chapterNumber={34} headings={headings} searchSections={searchSections} tocTitles={["Evaluate the whole system","Contracts & cases","Outcomes & traces","Find the failure layer","Choose & validate graders","Slices & repeated trials","Compare & set gates","Offline to real use","Python workbook","Evaluation lab","Knowledge check","Revision & next steps"]} searchPlaceholder="Try “calibration”, “paired”, or “p95”…">
  <div class="breadcrumb"><a href="/curriculum/">Handbook</a><span>/</span><span>Part 09 · Evaluation, security &amp; production</span></div>
  <header class="chapter-hero">
    <div class="hero-kicker"><span class="chapter-pill">CHAPTER 34</span><span class="edition">MEASURE · COMPARE · INVESTIGATE</span></div>
    <h1>Evaluate the whole system.<br/><em>Look beyond the average.</em></h1>
    <p class="hero-description">Measure answers, evidence, and actions,<br class="desktop-break"/> then decide what an improvement really means.</p>
    <div class="chapter-meta"><span><i aria-hidden="true">◷</i> 15–20 min core reading</span><span>20–30 min practice</span><span>12 short sections</span></div>
    <div class="hero-actions screen-only"><a href="#1-evaluate-the-application-the-user-actually-experiences" class="primary-button">Start learning <span>↓</span></a><a class="text-button" href="/downloads/ai-handbook-chapter-34.pdf" download>Download PDF <span>↗</span></a><button class="text-button" id="print-chapter">Print chapter</button></div>
    <div class="hero-illustration" aria-hidden="true"><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="orbit orbit-three"></div><span class="orbit-node n1"></span><span class="orbit-node n2"></span><span class="orbit-node n3"></span><span class="orbit-label">CASES → RUNS → GRADES → DECISION</span></div>
  </header>
  <div class="reader-tools screen-only"><button id="save-place" class="small-button">Bookmark this section</button><a id="resume-place" hidden>Resume saved section →</a><details class="reader-options"><summary>More reading tools</summary><div class="reader-tools-inner"><span class="local-note">Progress is saved in this browser.</span><div class="backup-actions"><button id="export-progress" class="small-button">Export progress</button><label class="small-button" for="import-progress">Import progress<input id="import-progress" type="file" accept="application/json"/></label></div></div></details></div>
  <div class="chapter-content"><Chapter /></div>
  <section class="completion-card screen-only" aria-labelledby="completion-title"><span class="eyebrow">PAUSE. EXPLAIN. CONNECT.</span><h2 id="completion-title">Can you explain what the score leaves out?</h2><p>Define task success, inspect paired regressions, and explain why a better average can still fail a release gate.</p><button id="complete-chapter" class="primary-button" aria-pressed="false">Mark Chapter 34 complete</button><p id="completion-status" class="local-note">Your completion status is saved only in this browser.</p></section>
  <footer class="chapter-end"><div><span class="eyebrow">NEXT IN THE HANDBOOK</span><h3>AI security and responsible use</h3><p>Examine adversarial inputs, sensitive data, permission boundaries, and responsible application behavior.</p><a class="text-button" href="/chapters/33-mcp-and-multi-agent-systems/">← Revisit Chapter 33</a></div><a class="primary-button" href="/chapters/35-ai-security-and-responsible-use/">Read Chapter 35 →</a></footer>
  <div class="edition-footer">AI, understood · Personal learning edition · Chapter 34 · About {(Math.round(words/100)*100).toLocaleString()} words</div>
</BookLayout>
