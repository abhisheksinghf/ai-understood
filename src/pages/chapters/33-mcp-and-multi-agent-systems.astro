---
import BookLayout from '../../layouts/BookLayout.astro';
import Chapter, {getHeadings} from '../../content/chapter-33.mdx';
import raw from '../../content/chapter-33.mdx?raw';
const headings=getHeadings();
const chunks=raw.split(/^## /m).slice(1);
const searchSections=headings.filter(h=>h.depth===2).map((h,i)=>({title:h.text,slug:h.slug,body:(chunks[i]||'').split('\n').slice(1).join(' ').replace(/<[^>]+>/g,' ').replace(/[`*#|]/g,'').replace(/\s+/g,' ').trim()}));
const words=raw.replace(/<[^>]+>/g,' ').split(/\s+/).filter(Boolean).length;
---
<BookLayout title="MCP and multi-agent systems" chapter chapterNumber={33} headings={headings} searchSections={searchSections} tocTitles={["Connection vs coordination","Host, client & server","Tools, resources & prompts","The message lifecycle","Trust boundaries","Reply ownership","Dependencies & parallel work","Evidence & limits","Python workbook","Coordination lab","Knowledge check","Revision & next steps"]} searchPlaceholder="Try “handoff”, “capabilities”, or “fan-out”…">
  <div class="breadcrumb"><a href="/curriculum/">Handbook</a><span>/</span><span>Part 08 · Tools, workflows &amp; agents</span></div>
  <header class="chapter-hero">
    <div class="hero-kicker"><span class="chapter-pill">CHAPTER 33</span><span class="edition">CONNECT · DELEGATE · VERIFY</span></div>
    <h1>Connect the capabilities.<br/><em>Coordinate the work.</em></h1>
    <p class="hero-description">Understand MCP and specialist agents,<br class="desktop-break"/> while keeping ownership and evidence clear.</p>
    <div class="chapter-meta"><span><i aria-hidden="true">◷</i> 15–20 min core reading</span><span>20–30 min practice</span><span>12 short sections</span></div>
    <div class="hero-actions screen-only"><a href="#1-two-problems-connecting-and-coordinating" class="primary-button">Start learning <span>↓</span></a><a class="text-button" href="/downloads/ai-handbook-chapter-33.pdf" download>Download PDF <span>↗</span></a><button class="text-button" id="print-chapter">Print chapter</button></div>
    <div class="hero-illustration" aria-hidden="true"><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="orbit orbit-three"></div><span class="orbit-node n1"></span><span class="orbit-node n2"></span><span class="orbit-node n3"></span><span class="orbit-label">CONNECT → DELEGATE → COLLECT → VERIFY</span></div>
  </header>
  <div class="reader-tools screen-only"><button id="save-place" class="small-button">Bookmark this section</button><a id="resume-place" hidden>Resume saved section →</a><details class="reader-options"><summary>More reading tools</summary><div class="reader-tools-inner"><span class="local-note">Progress is saved in this browser.</span><div class="backup-actions"><button id="export-progress" class="small-button">Export progress</button><label class="small-button" for="import-progress">Import progress<input id="import-progress" type="file" accept="application/json"/></label></div></div></details></div>
  <div class="chapter-content"><Chapter /></div>
  <section class="completion-card screen-only" aria-labelledby="completion-title"><span class="eyebrow">PAUSE. EXPLAIN. CONNECT.</span><h2 id="completion-title">Can you trace the connection and the responsibility?</h2><p>Explain what MCP connects, who owns the final answer, and why specialist evidence must match the original request.</p><button id="complete-chapter" class="primary-button" aria-pressed="false">Mark Chapter 33 complete</button><p id="completion-status" class="local-note">Your completion status is saved only in this browser.</p></section>
  <footer class="chapter-end"><div><span class="eyebrow">NEXT IN THE HANDBOOK</span><h3>Evaluating complete AI systems</h3><p>Evaluate the whole application across answer quality, retrieval, tool actions, and operational behavior.</p><a class="text-button" href="/chapters/32-building-ai-agents/">← Revisit Chapter 32</a></div><a class="primary-button" href="/chapters/34-evaluating-complete-ai-systems/">Read Chapter 34 →</a></footer>
  <div class="edition-footer">AI, understood · Personal learning edition · Chapter 33 · About {(Math.round(words/100)*100).toLocaleString()} words</div>
</BookLayout>
