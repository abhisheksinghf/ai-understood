---
import BookLayout from '../../layouts/BookLayout.astro';
import Chapter, {getHeadings} from '../../content/chapter-15.mdx';
import raw from '../../content/chapter-15.mdx?raw';
const headings=getHeadings();
const chunks=raw.split(/^## /m).slice(1);
const searchSections=headings.filter(h=>h.depth===2).map((h,i)=>({title:h.text,slug:h.slug,body:(chunks[i]||'').split('\n').slice(1).join(' ').replace(/<[^>]+>/g,' ').replace(/[`*#|]/g,'').replace(/\s+/g,' ').trim()}));
const words=raw.replace(/<[^>]+>/g,' ').split(/\s+/).filter(Boolean).length;
---
<BookLayout title="Evaluating and improving ML models" chapter chapterNumber={15} headings={headings} searchSections={searchSections} tocTitles={["Define useful success","Selection & test boundaries","Confusion & metrics","Choose a threshold","Ranking & ROC-AUC","Evaluate numerical targets","Calibration & uncertainty","Improve the cause","Try the evaluation lab","Python & practice","Knowledge check","Revision & connections"]} searchPlaceholder="Try “precision”, “calibration”, or “cross-validation”…">
  <div class="breadcrumb"><a href="/curriculum/">Handbook</a><span>/</span><span>Part 04 · Data &amp; classical machine learning</span></div>
  <header class="chapter-hero">
    <div class="hero-kicker"><span class="chapter-pill">CHAPTER 15</span><span class="edition">MEASURE THE ERRORS · IMPROVE WITH EVIDENCE</span></div>
    <h1>Evaluating ML models.<br/><em>Measure. Compare. Improve.</em></h1>
    <p class="hero-description">Count the right errors. Compare models fairly.<br class="desktop-break"/> Turn evaluation into a reasoned next step.</p>
    <div class="chapter-meta"><span><i aria-hidden="true">◷</i> 18–22 min core reading</span><span>20–30 min practice</span><span>12 short sections</span></div>
    <div class="hero-actions screen-only"><a href="#1-define-success-before-comparing-scores" class="primary-button">Start learning <span>↓</span></a><a class="text-button" href="/downloads/ai-handbook-chapter-15.pdf" download>Download PDF <span>↗</span></a><button class="text-button" id="print-chapter">Print chapter</button></div>
    <div class="hero-illustration" aria-hidden="true"><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="orbit orbit-three"></div><span class="orbit-node n1"></span><span class="orbit-node n2"></span><span class="orbit-node n3"></span><span class="orbit-label">MEASURE → COMPARE → IMPROVE</span></div>
  </header>
  <div class="reader-tools screen-only"><button id="save-place" class="small-button">Bookmark this section</button><a id="resume-place" hidden>Resume saved section →</a><details class="reader-options"><summary>More reading tools</summary><div class="reader-tools-inner"><span class="local-note">Progress is saved in this browser.</span><div class="backup-actions"><button id="export-progress" class="small-button">Export progress</button><label class="small-button" for="import-progress">Import progress<input id="import-progress" type="file" accept="application/json"/></label></div></div></details></div>
  <div class="chapter-content"><Chapter /></div>
  <section class="completion-card screen-only" aria-labelledby="completion-title"><span class="eyebrow">PAUSE. EXPLAIN. CONNECT.</span><h2 id="completion-title">Can you explain which model helps, and why?</h2><p>Explain the error counts, choose a metric and threshold, and keep validation choices separate from final testing.</p><button id="complete-chapter" class="primary-button" aria-pressed="false">Mark Chapter 15 complete</button><p id="completion-status" class="local-note">Your completion status is saved only in this browser.</p></section>
  <footer class="chapter-end"><div><span class="eyebrow">NEXT IN THE HANDBOOK</span><h3>Information retrieval: how search works</h3><p>Begin Part 5: find relevant material before building embeddings and RAG.</p><a class="text-button" href="/chapters/14-unsupervised-learning-and-other-approaches/">← Revisit Chapter 14</a></div><a class="primary-button" href="/chapters/16-information-retrieval-how-search-works/">Read Chapter 16 <span>→</span></a></footer>
  <div class="edition-footer">AI, understood · Personal learning edition · Chapter 15 · About {(Math.round(words/100)*100).toLocaleString()} words</div>
</BookLayout>
