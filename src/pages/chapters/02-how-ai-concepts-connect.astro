---
import BookLayout from '../../layouts/BookLayout.astro';
import Chapter, { getHeadings } from '../../content/chapter-02.mdx';
import raw from '../../content/chapter-02.mdx?raw';
const headings=getHeadings();
const chunks=raw.split(/^## /m).slice(1);
const searchSections=headings.filter(h=>h.depth===2).map((h,i)=>({title:h.text,slug:h.slug,body:(chunks[i]||'').split('\n').slice(1).join(' ').replace(/<[^>]+>/g,' ').replace(/[`*#|]/g,'').replace(/\s+/g,' ').trim()}));
const words=raw.replace(/<[^>]+>/g,' ').split(/\s+/).filter(Boolean).length;
---
<BookLayout title="How the AI concepts connect" chapter chapterNumber={2} headings={headings} searchSections={searchSections} tocTitles={["A map of the terms","ML & deep learning","NLP: language tasks","GenAI & LLMs","Retrieval and generation","Workflows, tools & agents","One connected application","Where AGI fits","Choose from the need","Practice exercises","Knowledge check","Revision & sources"]} searchPlaceholder="Try “RAG”, “parameters”, or “agent”…">
  <div class="breadcrumb"><a href="/curriculum/">Handbook</a><span>/</span><span>Part 01 · Foundations</span></div>
  <header class="chapter-hero">
    <div class="hero-kicker"><span class="chapter-pill">CHAPTER 02</span><span class="edition">CONNECT THE IDEAS</span></div>
    <h1>How the AI<br/><em>concepts connect.</em></h1>
    <p class="hero-description">Make sense of the names. See how they fit.<br class="desktop-break"/> Follow one assistant from model to application.</p>
    <div class="chapter-meta"><span><i aria-hidden="true">◷</i> 18–22 min core reading</span><span>Beginner friendly</span><span>12 short sections</span></div>
    <div class="hero-actions screen-only"><a href="#1-start-with-the-question-each-term-answers" class="primary-button">Start learning <span>↓</span></a><a class="text-button" href="/downloads/ai-handbook-chapter-02.pdf" download>Download PDF <span>↗</span></a><button class="text-button" id="print-chapter">Print chapter</button></div>
    <div class="hero-illustration" aria-hidden="true"><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="orbit orbit-three"></div><span class="orbit-node n1"></span><span class="orbit-node n2"></span><span class="orbit-node n3"></span><span class="orbit-label">MODEL → CONTEXT → SYSTEM</span></div>
  </header>
  <div class="reader-tools screen-only"><button id="save-place" class="small-button">Bookmark this section</button><a id="resume-place" hidden>Resume saved section →</a><details class="reader-options"><summary>More reading tools</summary><div class="reader-tools-inner"><span class="local-note">Progress is saved in this browser.</span><div class="backup-actions"><button id="export-progress" class="small-button">Export progress</button><label class="small-button" for="import-progress">Import progress<input id="import-progress" type="file" accept="application/json"/></label></div></div></details></div>
  <div class="chapter-content"><Chapter /></div>
  <section class="completion-card screen-only" aria-labelledby="completion-title"><span class="eyebrow">PAUSE. EXPLAIN. CONNECT.</span><h2 id="completion-title">Can you explain it in your own words?</h2><p>Describe your own assistant: its task, model, information sources, and control flow. Mark the chapter complete when you can explain each label.</p><button id="complete-chapter" class="primary-button" aria-pressed="false">Mark Chapter 2 complete</button><p id="completion-status" class="local-note">Your completion status is saved only in this browser.</p></section>
  <footer class="chapter-end"><div><span class="eyebrow">NEXT IN THE HANDBOOK</span><h3>How models learn</h3><p>Data, objectives, fitted parameters, and mistakes.</p><a class="text-button" href="/chapters/01-what-is-ai/">← Revisit Chapter 1</a></div><a class="primary-button" href="/chapters/03-how-models-learn/">Read Chapter 3 →</a></footer>
  <div class="edition-footer">AI, understood · Personal learning edition · Chapter 02 · About {(Math.round(words/100)*100).toLocaleString()} words</div>
</BookLayout>
