---
import BookLayout from '../../layouts/BookLayout.astro';
import Chapter, {getHeadings} from '../../content/chapter-18.mdx';
import raw from '../../content/chapter-18.mdx?raw';
const headings=getHeadings();
const chunks=raw.split(/^## /m).slice(1);
const searchSections=headings.filter(h=>h.depth===2).map((h,i)=>({title:h.text,slug:h.slug,body:(chunks[i]||'').split('\n').slice(1).join(' ').replace(/<[^>]+>/g,' ').replace(/[`*#|]/g,'').replace(/\s+/g,' ').trim()}));
const words=raw.replace(/<[^>]+>/g,' ').split(/\s+/).filter(Boolean).length;
---
<BookLayout title="Building a RAG system step by step" chapter chapterNumber={18} headings={headings} searchSections={searchSections} tocTitles={["What RAG adds","Two connected paths","Sources & provenance","Choose chunk boundaries","Retrieve candidates","Build the context","Generate from evidence","Check citations","Try the RAG pipeline","Python & practice","Knowledge check","Evaluate the system"]} searchPlaceholder="Try “chunking”, “provenance”, or “citation”…">
  <div class="breadcrumb"><a href="/curriculum/">Handbook</a><span>/</span><span>Part 05 · Search, embeddings &amp; RAG</span></div>
  <header class="chapter-hero">
    <div class="hero-kicker"><span class="chapter-pill">CHAPTER 18</span><span class="edition">RETRIEVE EVIDENCE · BUILD THE ANSWER</span></div>
    <h1>Build a RAG system.<br/><em>Follow the evidence.</em></h1>
    <p class="hero-description">Connect sources, retrieval, and generation.<br class="desktop-break"/> Understand every step between a question and its evidence.</p>
    <div class="chapter-meta"><span><i aria-hidden="true">◷</i> 18–22 min core reading</span><span>25–35 min practice</span><span>12 short sections</span></div>
    <div class="hero-actions screen-only"><a href="#1-rag-connects-retrieval-to-generation" class="primary-button">Start learning <span>↓</span></a><a class="text-button" href="/downloads/ai-handbook-chapter-18.pdf" download>Download PDF <span>↗</span></a><button class="text-button" id="print-chapter">Print chapter</button></div>
    <div class="hero-illustration" aria-hidden="true"><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="orbit orbit-three"></div><span class="orbit-node n1"></span><span class="orbit-node n2"></span><span class="orbit-node n3"></span><span class="orbit-label">RETRIEVE → CONTEXT → ANSWER</span></div>
  </header>
  <div class="reader-tools screen-only"><button id="save-place" class="small-button">Bookmark this section</button><a id="resume-place" hidden>Resume saved section →</a><details class="reader-options"><summary>More reading tools</summary><div class="reader-tools-inner"><span class="local-note">Progress is saved in this browser.</span><div class="backup-actions"><button id="export-progress" class="small-button">Export progress</button><label class="small-button" for="import-progress">Import progress<input id="import-progress" type="file" accept="application/json"/></label></div></div></details></div>
  <div class="chapter-content"><Chapter /></div>
  <section class="completion-card screen-only" aria-labelledby="completion-title"><span class="eyebrow">PAUSE. EXPLAIN. CONNECT.</span><h2 id="completion-title">Can you trace the answer back to its evidence?</h2><p>Locate the sources, explain the context selection, and distinguish valid citations from relevant, supported answers.</p><button id="complete-chapter" class="primary-button" aria-pressed="false">Mark Chapter 18 complete</button><p id="completion-status" class="local-note">Your completion status is saved only in this browser.</p></section>
  <footer class="chapter-end"><div><span class="eyebrow">NEXT IN THE HANDBOOK</span><h3>Improving and evaluating RAG</h3><p>Measure retrieval, grounding, completeness, and abstention before changing the pipeline.</p><a class="text-button" href="/chapters/17-embeddings-and-vector-search/">← Revisit Chapter 17</a></div><a class="text-button" href="/chapters/19-improving-and-evaluating-rag/">Read Chapter 19 →</a></footer>
  <div class="edition-footer">AI, understood · Personal learning edition · Chapter 18 · About {(Math.round(words/100)*100).toLocaleString()} words</div>
</BookLayout>
