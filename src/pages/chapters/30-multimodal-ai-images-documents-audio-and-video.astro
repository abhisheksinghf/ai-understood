---
import BookLayout from '../../layouts/BookLayout.astro';
import Chapter, {getHeadings} from '../../content/chapter-30.mdx';
import raw from '../../content/chapter-30.mdx?raw';
const headings=getHeadings();
const chunks=raw.split(/^## /m).slice(1);
const searchSections=headings.filter(h=>h.depth===2).map((h,i)=>({title:h.text,slug:h.slug,body:(chunks[i]||'').split('\n').slice(1).join(' ').replace(/<[^>]+>/g,' ').replace(/[`*#|]/g,'').replace(/\s+/g,' ').trim()}));
const words=raw.replace(/<[^>]+>/g,' ').split(/\s+/).filter(Boolean).length;
---
<BookLayout title="Multimodal AI: images, documents, audio, and video" chapter chapterNumber={30} headings={headings} searchSections={searchSections} tocTitles={["Define the task","Represent images","Align modalities","Connect vision & language","Read documents","Understand audio","Keep time in video","Build with evidence","Evaluate each link","Explore & practice","Knowledge check","From evidence to actions"]} searchPlaceholder="Try “alignment”, “OCR”, or “timestamps”…">
  <div class="breadcrumb"><a href="/curriculum/">Handbook</a><span>/</span><span>Part 07 · Adaptation &amp; multimodal AI</span></div>
  <header class="chapter-hero">
    <div class="hero-kicker"><span class="chapter-pill">CHAPTER 30</span><span class="edition">SEE · HEAR · CONNECT</span></div>
    <h1>Connect the senses.<br/><em>Keep the evidence connected.</em></h1>
    <p class="hero-description">Connect text, images, documents, audio, and video,<br class="desktop-break"/> then inspect what each source can actually support.</p>
    <div class="chapter-meta"><span><i aria-hidden="true">◷</i> 20–25 min core reading</span><span>20–30 min practice</span><span>12 short sections</span></div>
    <div class="hero-actions screen-only"><a href="#1-start-with-the-task-and-the-modalities" class="primary-button">Start learning <span>↓</span></a><a class="text-button" href="/downloads/ai-handbook-chapter-30.pdf" download>Download PDF <span>↗</span></a><button class="text-button" id="print-chapter">Print chapter</button></div>
    <div class="hero-illustration" aria-hidden="true"><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="orbit orbit-three"></div><span class="orbit-node n1"></span><span class="orbit-node n2"></span><span class="orbit-node n3"></span><span class="orbit-label">MEDIA → REPRESENTATION → EVIDENCE</span></div>
  </header>
  <div class="reader-tools screen-only"><button id="save-place" class="small-button">Bookmark this section</button><a id="resume-place" hidden>Resume saved section →</a><details class="reader-options"><summary>More reading tools</summary><div class="reader-tools-inner"><span class="local-note">Progress is saved in this browser.</span><div class="backup-actions"><button id="export-progress" class="small-button">Export progress</button><label class="small-button" for="import-progress">Import progress<input id="import-progress" type="file" accept="application/json"/></label></div></div></details></div>
  <div class="chapter-content"><Chapter /></div>
  <section class="completion-card screen-only" aria-labelledby="completion-title"><span class="eyebrow">PAUSE. EXPLAIN. CONNECT.</span><h2 id="completion-title">Can you trace an answer back to the right source?</h2><p>Explain alignment and fusion, keep document and media locations intact, and distinguish missing evidence from evidence of absence.</p><button id="complete-chapter" class="primary-button" aria-pressed="false">Mark Chapter 30 complete</button><p id="completion-status" class="local-note">Your completion status is saved only in this browser.</p></section>
  <footer class="chapter-end"><div><span class="eyebrow">NEXT IN THE HANDBOOK</span><h3>Tool calling and explicit workflows</h3><p>Give the assistant controlled tools, typed arguments, and explicit steps for reliable actions.</p><a class="text-button" href="/chapters/29-generative-ai-beyond-language/">← Revisit Chapter 29</a></div><a class="primary-button" href="/chapters/31-tool-calling-and-explicit-workflows/">Read Chapter 31 →</a></footer>
  <div class="edition-footer">AI, understood · Personal learning edition · Chapter 30 · About {(Math.round(words/100)*100).toLocaleString()} words</div>
</BookLayout>
