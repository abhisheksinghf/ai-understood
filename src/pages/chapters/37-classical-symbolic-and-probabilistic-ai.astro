---
import BookLayout from '../../layouts/BookLayout.astro';
import Chapter, {getHeadings} from '../../content/chapter-37.mdx';
import raw from '../../content/chapter-37.mdx?raw';
const headings=getHeadings();
const chunks=raw.split(/^## /m).slice(1);
const searchSections=headings.filter(h=>h.depth===2).map((h,i)=>({title:h.text,slug:h.slug,body:(chunks[i]||'').split('\n').slice(1).join(' ').replace(/<[^>]+>/g,' ').replace(/[`*#|]/g,'').replace(/\s+/g,' ').trim()}));
const words=raw.replace(/<[^>]+>/g,' ').split(/\s+/).filter(Boolean).length;
---
<BookLayout title="Classical, symbolic, and probabilistic AI" chapter chapterNumber={37} headings={headings} searchSections={searchSections} tocTitles={["Beyond learned predictions","Facts & logical inference","Search strategies","Heuristics & guarantees","Planning with actions","Constraints & feasibility","Bayesian reasoning","Expected utility","Python workbook","Movie reasoning lab","Knowledge check","Revision & next steps"]} searchPlaceholder="Try “heuristic”, “Bayes”, or “utility”…">
  <div class="breadcrumb"><a href="/curriculum/">Handbook</a><span>/</span><span>Part 10 · Broader AI &amp; your capstone</span></div>
  <header class="chapter-hero">
    <div class="hero-kicker"><span class="chapter-pill">CHAPTER 37</span><span class="edition">REPRESENT · SEARCH · REASON</span></div>
    <h1>Facts, plans, and beliefs.<br/><em>Reason beyond prediction.</em></h1>
    <p class="hero-description">Explore symbolic and probabilistic AI,<br class="desktop-break"/> from explicit rules to decisions under uncertainty.</p>
    <div class="chapter-meta"><span><i aria-hidden="true">◷</i> 15–20 min core reading</span><span>20–30 min practice</span><span>12 short sections</span></div>
    <div class="hero-actions screen-only"><a href="#1-ai-includes-more-than-learned-predictions" class="primary-button">Start learning <span>↓</span></a><a class="text-button" href="/downloads/ai-handbook-chapter-37.pdf" download>Download PDF <span>↗</span></a><button class="text-button" id="print-chapter">Print chapter</button></div>
    <div class="hero-illustration" aria-hidden="true"><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="orbit orbit-three"></div><span class="orbit-node n1"></span><span class="orbit-node n2"></span><span class="orbit-node n3"></span><span class="orbit-label">FACTS → CONSTRAINTS → BELIEFS → CHOICES</span></div>
  </header>
  <div class="reader-tools screen-only"><button id="save-place" class="small-button">Bookmark this section</button><a id="resume-place" hidden>Resume saved section →</a><details class="reader-options"><summary>More reading tools</summary><div class="reader-tools-inner"><span class="local-note">Progress is saved in this browser.</span><div class="backup-actions"><button id="export-progress" class="small-button">Export progress</button><label class="small-button" for="import-progress">Import progress<input id="import-progress" type="file" accept="application/json"/></label></div></div></details></div>
  <div class="chapter-content"><Chapter /></div>
  <section class="completion-card screen-only" aria-labelledby="completion-title"><span class="eyebrow">PAUSE. EXPLAIN. CONNECT.</span><h2 id="completion-title">Can you explain how the decision was reached?</h2><p>Distinguish feasibility from preference, trace a search, and explain how evidence changes a belief and a decision.</p><button id="complete-chapter" class="primary-button" aria-pressed="false">Mark Chapter 37 complete</button><p id="completion-status" class="local-note">Your completion status is saved only in this browser.</p></section>
  <footer class="chapter-end"><div><span class="eyebrow">NEXT IN THE HANDBOOK</span><h3>Reinforcement learning and robotics</h3><p>Learn how agents improve actions through interaction, feedback, and delayed rewards.</p><a class="text-button" href="/chapters/36-deploying-and-operating-ai-applications/">← Revisit Chapter 36</a></div><a class="primary-button" href="/chapters/38-reinforcement-learning-and-robotics/">Read Chapter 38 →</a></footer>
  <div class="edition-footer">AI, understood · Personal learning edition · Chapter 37 · About {(Math.round(words/100)*100).toLocaleString()} words</div>
</BookLayout>
