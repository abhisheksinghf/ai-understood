---
import BookLayout from '../../layouts/BookLayout.astro';
import Chapter, {getHeadings} from '../../content/chapter-32.mdx';
import raw from '../../content/chapter-32.mdx?raw';
const headings=getHeadings();
const chunks=raw.split(/^## /m).slice(1);
const searchSections=headings.filter(h=>h.depth===2).map((h,i)=>({title:h.text,slug:h.slug,body:(chunks[i]||'').split('\n').slice(1).join(' ').replace(/<[^>]+>/g,' ').replace(/[`*#|]/g,'').replace(/\s+/g,' ').trim()}));
const words=raw.replace(/<[^>]+>/g,' ').split(/\s+/).filter(Boolean).length;
---
<BookLayout title="Building AI agents" chapter chapterNumber={32} headings={headings} searchSections={searchSections} tocTitles={["What makes an agent","Define success","Build the loop","Plan & adapt","State, context & memory","Control tool authority","Know when to stop","Evaluate the whole run","Python runner","Step through & practice","Knowledge check","From one agent to many"]} searchPlaceholder="Try “memory”, “replanning”, or “trajectory”…">
  <div class="breadcrumb"><a href="/curriculum/">Handbook</a><span>/</span><span>Part 08 · Tools, workflows &amp; agents</span></div>
  <header class="chapter-hero">
    <div class="hero-kicker"><span class="chapter-pill">CHAPTER 32</span><span class="edition">OBSERVE · DECIDE · ADAPT</span></div>
    <h1>Build an agent.<br/><em>Keep its decisions grounded.</em></h1>
    <p class="hero-description">Connect a goal to actions and observations,<br class="desktop-break"/> then test how the next decision changes.</p>
    <div class="chapter-meta"><span><i aria-hidden="true">◷</i> 15–20 min core reading</span><span>20–30 min practice</span><span>12 short sections</span></div>
    <div class="hero-actions screen-only"><a href="#1-what-makes-a-system-an-agent" class="primary-button">Start learning <span>↓</span></a><a class="text-button" href="/downloads/ai-handbook-chapter-32.pdf" download>Download PDF <span>↗</span></a><button class="text-button" id="print-chapter">Print chapter</button></div>
    <div class="hero-illustration" aria-hidden="true"><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="orbit orbit-three"></div><span class="orbit-node n1"></span><span class="orbit-node n2"></span><span class="orbit-node n3"></span><span class="orbit-label">GOAL → ACTION → OBSERVATION → DECISION</span></div>
  </header>
  <div class="reader-tools screen-only"><button id="save-place" class="small-button">Bookmark this section</button><a id="resume-place" hidden>Resume saved section →</a><details class="reader-options"><summary>More reading tools</summary><div class="reader-tools-inner"><span class="local-note">Progress is saved in this browser.</span><div class="backup-actions"><button id="export-progress" class="small-button">Export progress</button><label class="small-button" for="import-progress">Import progress<input id="import-progress" type="file" accept="application/json"/></label></div></div></details></div>
  <div class="chapter-content"><Chapter /></div>
  <section class="completion-card screen-only" aria-labelledby="completion-title"><span class="eyebrow">PAUSE. EXPLAIN. CONNECT.</span><h2 id="completion-title">Can you explain why the next action changed?</h2><p>Trace decisions back to observations, distinguish state from context, and explain when an agent should finish, ask, or stop.</p><button id="complete-chapter" class="primary-button" aria-pressed="false">Mark Chapter 32 complete</button><p id="completion-status" class="local-note">Your completion status is saved only in this browser.</p></section>
  <footer class="chapter-end"><div><span class="eyebrow">NEXT IN THE HANDBOOK</span><h3>MCP and multi-agent systems</h3><p>Connect tools through a shared protocol and examine how multiple agents coordinate work.</p><a class="text-button" href="/chapters/31-tool-calling-and-explicit-workflows/">← Revisit Chapter 31</a></div><a class="primary-button" href="/chapters/33-mcp-and-multi-agent-systems/">Read Chapter 33 →</a></footer>
  <div class="edition-footer">AI, understood · Personal learning edition · Chapter 32 · About {(Math.round(words/100)*100).toLocaleString()} words</div>
</BookLayout>
