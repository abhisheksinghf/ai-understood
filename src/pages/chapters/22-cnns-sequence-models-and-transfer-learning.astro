---
import BookLayout from '../../layouts/BookLayout.astro';
import Chapter, {getHeadings} from '../../content/chapter-22.mdx';
import raw from '../../content/chapter-22.mdx?raw';
const headings=getHeadings();
const chunks=raw.split(/^## /m).slice(1);
const searchSections=headings.filter(h=>h.depth===2).map((h,i)=>({title:h.text,slug:h.slug,body:(chunks[i]||'').split('\n').slice(1).join(' ').replace(/<[^>]+>/g,' ').replace(/[`*#|]/g,'').replace(/\s+/g,' ').trim()}));
const words=raw.replace(/<[^>]+>/g,' ').split(/\s+/).filter(Boolean).length;
---
<BookLayout title="CNNs, sequence models, and transfer learning" chapter chapterNumber={22} headings={headings} searchSections={searchSections} tocTitles={["Match the structure","Slide a filter","Shapes & pooling","Build representations","Preserve order","Trace a recurrent state","Understand gates","Reuse a backbone","Adapt & evaluate","Explore & practice","Knowledge check","Connect to language"]} searchPlaceholder="Try “padding”, “LSTM”, or “transfer”…">
  <div class="breadcrumb"><a href="/curriculum/">Handbook</a><span>/</span><span>Part 06 · Deep learning &amp; LLM internals</span></div>
  <header class="chapter-hero">
    <div class="hero-kicker"><span class="chapter-pill">CHAPTER 22</span><span class="edition">SPACE · ORDER · REUSE</span></div>
    <h1>Images and sequences.<br/><em>Structure meets learning.</em></h1>
    <p class="hero-description">Read a poster, follow a viewing history,<br class="desktop-break"/> and understand how models reuse learned features.</p>
    <div class="chapter-meta"><span><i aria-hidden="true">◷</i> 20–25 min core reading</span><span>20–30 min practice</span><span>12 short sections</span></div>
    <div class="hero-actions screen-only"><a href="#1-let-the-input-structure-guide-the-architecture" class="primary-button">Start learning <span>↓</span></a><a class="text-button" href="/downloads/ai-handbook-chapter-22.pdf" download>Download PDF <span>↗</span></a><button class="text-button" id="print-chapter">Print chapter</button></div>
    <div class="hero-illustration" aria-hidden="true"><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="orbit orbit-three"></div><span class="orbit-node n1"></span><span class="orbit-node n2"></span><span class="orbit-node n3"></span><span class="orbit-label">FILTER → REMEMBER → ADAPT</span></div>
  </header>
  <div class="reader-tools screen-only"><button id="save-place" class="small-button">Bookmark this section</button><a id="resume-place" hidden>Resume saved section →</a><details class="reader-options"><summary>More reading tools</summary><div class="reader-tools-inner"><span class="local-note">Progress is saved in this browser.</span><div class="backup-actions"><button id="export-progress" class="small-button">Export progress</button><label class="small-button" for="import-progress">Import progress<input id="import-progress" type="file" accept="application/json"/></label></div></div></details></div>
  <div class="chapter-content"><Chapter /></div>
  <section class="completion-card screen-only" aria-labelledby="completion-title"><span class="eyebrow">PAUSE. EXPLAIN. CONNECT.</span><h2 id="completion-title">Can you explain what the architecture preserves?</h2><p>Trace a local filter, explain an order-sensitive state, and distinguish a frozen backbone from a trained head.</p><button id="complete-chapter" class="primary-button" aria-pressed="false">Mark Chapter 22 complete</button><p id="completion-status" class="local-note">Your completion status is saved only in this browser.</p></section>
  <footer class="chapter-end"><div><span class="eyebrow">NEXT IN THE HANDBOOK</span><h3>NLP, tokenization, and language modeling</h3><p>Turn language into model inputs and understand what predicting text means.</p><a class="text-button" href="/chapters/21-training-and-debugging-neural-networks/">← Revisit Chapter 21</a></div><a class="primary-button" href="/chapters/23-nlp-tokenization-and-language-modeling/">Read Chapter 23 →</a></footer>
  <div class="edition-footer">AI, understood · Personal learning edition · Chapter 22 · About {(Math.round(words/100)*100).toLocaleString()} words</div>
</BookLayout>
