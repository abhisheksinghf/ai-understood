---
import BookLayout from '../../layouts/BookLayout.astro';
import Chapter, { getHeadings } from '../../content/chapter-10.mdx';
import raw from '../../content/chapter-10.mdx?raw';
const headings=getHeadings();
const chunks=raw.split(/^## /m).slice(1);
const searchSections=headings.filter(h=>h.depth===2).map((h,i)=>({title:h.text,slug:h.slug,body:(chunks[i]||'').split('\n').slice(1).join(' ').replace(/<[^>]+>/g,' ').replace(/[`*#|]/g,'').replace(/\s+/g,' ').trim()}));
const words=raw.replace(/<[^>]+>/g,' ').split(/\s+/).filter(Boolean).length;
---
<BookLayout title="Building an LLM application with Python" chapter chapterNumber={10} headings={headings} searchSections={searchSections} tocTitles={["One useful workflow","Application architecture","Run the Python app","Build the request","The service boundary","Validate the response","Retries & stopping","Application trace","Testing & evaluation","Practice exercises","Knowledge check","Revision & connections"]} searchPlaceholder="Try “adapter”, “idempotency”, or “streaming”…">
  <div class="breadcrumb"><a href="/curriculum/">Handbook</a><span>/</span><span>Part 03 · Your first LLM application</span></div>
  <header class="chapter-hero">
    <div class="hero-kicker"><span class="chapter-pill">CHAPTER 10</span><span class="edition">FROM PROMPT TO WORKING SOFTWARE</span></div>
    <h1>Build an LLM app<br/><em>with Python.</em></h1>
    <p class="hero-description">Connect a model to a useful workflow.<br class="desktop-break"/> Validate the result. Handle the unexpected.</p>
    <div class="chapter-meta"><span><i aria-hidden="true">◷</i> 22–27 min core reading</span><span>Offline lab + optional live API</span><span>12 short sections</span></div>
    <div class="hero-actions screen-only"><a href="#1-build-one-useful-vertical-slice" class="primary-button">Start learning <span>↓</span></a><a class="text-button" href="/downloads/ai-handbook-chapter-10.pdf" download>Download PDF <span>↗</span></a><button class="text-button" id="print-chapter">Print chapter</button></div>
    <div class="hero-illustration" aria-hidden="true"><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="orbit orbit-three"></div><span class="orbit-node n1"></span><span class="orbit-node n2"></span><span class="orbit-node n3"></span><span class="orbit-label">REQUEST → VALIDATE → REVIEW</span></div>
  </header>
  <div class="reader-tools screen-only"><button id="save-place" class="small-button">Bookmark this section</button><a id="resume-place" hidden>Resume saved section →</a><details class="reader-options"><summary>More reading tools</summary><div class="reader-tools-inner"><span class="local-note">Progress is saved in this browser.</span><div class="backup-actions"><button id="export-progress" class="small-button">Export progress</button><label class="small-button" for="import-progress">Import progress<input id="import-progress" type="file" accept="application/json"/></label></div></div></details></div>
  <div class="chapter-content"><Chapter /></div>
  <section class="completion-card screen-only" aria-labelledby="completion-title"><span class="eyebrow">PAUSE. EXPLAIN. CONNECT.</span><h2 id="completion-title">Can you explain it in your own words?</h2><p>Trace a request through the application, explain when a retry is justified, and show why a valid draft still needs evidence review.</p><button id="complete-chapter" class="primary-button" aria-pressed="false">Mark Chapter 10 complete</button><p id="completion-status" class="local-note">Your completion status is saved only in this browser.</p></section>
  <footer class="chapter-end"><div><span class="eyebrow">NEXT IN THE HANDBOOK</span><h3>Project 1: a movie-recommendation assistant</h3><p>Combine the workflow with a usable interface and task-specific evaluation.</p><a class="text-button" href="/chapters/09-prompting-and-context-design/">← Revisit Chapter 9</a></div><a class="primary-button" href="/chapters/11-project-movie-recommendation-assistant/">Read Chapter 11 →</a></footer>
  <div class="edition-footer">AI, understood · Personal learning edition · Chapter 10 · About {(Math.round(words/100)*100).toLocaleString()} words</div>
</BookLayout>
