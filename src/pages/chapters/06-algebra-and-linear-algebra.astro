---
import BookLayout from '../../layouts/BookLayout.astro';
import Chapter, { getHeadings } from '../../content/chapter-06.mdx';
import raw from '../../content/chapter-06.mdx?raw';
const headings=getHeadings();
const chunks=raw.split(/^## /m).slice(1);
const searchSections=headings.filter(h=>h.depth===2).map((h,i)=>({title:h.text,slug:h.slug,body:(chunks[i]||'').split('\n').slice(1).join(' ').replace(/<[^>]+>/g,' ').replace(/[`*#|]/g,'').replace(/\s+/g,' ').trim()}));
const words=raw.replace(/<[^>]+>/g,' ').split(/\s+/).filter(Boolean).length;
---
<BookLayout title="Algebra and linear algebra for AI" chapter chapterNumber={6} headings={headings} searchSections={searchSections} tocTitles={["Read an equation","Scalars, vectors & shapes","Add, scale & measure","The dot product","Direction & similarity","Batch matrix calculations","Explore transformations","Rank & information loss","The Python workbook","Practice exercises","Knowledge check","Revision & connections"]} searchPlaceholder="Try “dot product”, “broadcasting”, or “eigenvector”…">
  <div class="breadcrumb"><a href="/curriculum/">Handbook</a><span>/</span><span>Part 02 · Mathematical foundations</span></div>
  <header class="chapter-hero">
    <div class="hero-kicker"><span class="chapter-pill">CHAPTER 06</span><span class="edition">MAKE THE MATHEMATICS VISIBLE</span></div>
    <h1>Algebra &amp;<br/><em>linear algebra.</em></h1>
    <p class="hero-description">From one number to a matrix.<br class="desktop-break"/> Understand the calculations that connect AI.</p>
    <div class="chapter-meta"><span><i aria-hidden="true">◷</i> 25–30 min core reading</span><span>Start with arithmetic</span><span>12 short sections</span></div>
    <div class="hero-actions screen-only"><a href="#1-read-an-equation-as-a-calculation" class="primary-button">Start learning <span>↓</span></a><a class="text-button" href="/downloads/ai-handbook-chapter-06.pdf" download>Download PDF <span>↗</span></a><button class="text-button" id="print-chapter">Print chapter</button></div>
    <div class="hero-illustration" aria-hidden="true"><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="orbit orbit-three"></div><span class="orbit-node n1"></span><span class="orbit-node n2"></span><span class="orbit-node n3"></span><span class="orbit-label">NAME → CALCULATE → INTERPRET</span></div>
  </header>
  <div class="reader-tools screen-only"><button id="save-place" class="small-button">Bookmark this section</button><a id="resume-place" hidden>Resume saved section →</a><details class="reader-options"><summary>More reading tools</summary><div class="reader-tools-inner"><span class="local-note">Progress is saved in this browser.</span><div class="backup-actions"><button id="export-progress" class="small-button">Export progress</button><label class="small-button" for="import-progress">Import progress<input id="import-progress" type="file" accept="application/json"/></label></div></div></details></div>
  <div class="chapter-content"><Chapter /></div>
  <section class="completion-card screen-only" aria-labelledby="completion-title"><span class="eyebrow">PAUSE. EXPLAIN. CONNECT.</span><h2 id="completion-title">Can you explain it in your own words?</h2><p>Calculate a dot product, check a matrix shape, and explain why a projection loses information. Use the workbook to test your arithmetic.</p><button id="complete-chapter" class="primary-button" aria-pressed="false">Mark Chapter 6 complete</button><p id="completion-status" class="local-note">Your completion status is saved only in this browser.</p></section>
  <footer class="chapter-end"><div><span class="eyebrow">NEXT IN THE HANDBOOK</span><h3>Probability and statistics for AI</h3><p>Describe uncertainty, distributions, and the evidence behind a result.</p><a class="text-button" href="/chapters/05-software-apis-and-data/">← Revisit Chapter 5</a></div><a class="primary-button" href="/chapters/07-probability-and-statistics/">Read Chapter 7 →</a></footer>
  <div class="edition-footer">AI, understood · Personal learning edition · Chapter 06 · About {(Math.round(words/100)*100).toLocaleString()} words</div>
</BookLayout>
