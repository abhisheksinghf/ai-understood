---
import BookLayout from '../../layouts/BookLayout.astro';
import Chapter, {getHeadings} from '../../content/chapter-21.mdx';
import raw from '../../content/chapter-21.mdx?raw';
const headings=getHeadings();
const chunks=raw.split(/^## /m).slice(1);
const searchSections=headings.filter(h=>h.depth===2).map((h,i)=>({title:h.text,slug:h.slug,body:(chunks[i]||'').split('\n').slice(1).join(' ').replace(/<[^>]+>/g,' ').replace(/[`*#|]/g,'').replace(/\s+/g,' ').trim()}));
const words=raw.replace(/<[^>]+>/g,' ').split(/\s+/).filter(Boolean).length;
---
<BookLayout title="Training and debugging neural networks" chapter chapterNumber={21} headings={headings} searchSections={searchSections} tocTitles={["Define the experiment","Scale & initialize","The training loop","Optimizer & rate","Read the curves","Regularize fitting","Debug the gradients","Choose a checkpoint","Try the workbench","Python & practice","Knowledge check","Compare experiments"]} searchPlaceholder="Try “patience”, “dropout”, or “scaling”…">
  <div class="breadcrumb"><a href="/curriculum/">Handbook</a><span>/</span><span>Part 06 · Deep learning &amp; LLM internals</span></div>
  <header class="chapter-hero">
    <div class="hero-kicker"><span class="chapter-pill">CHAPTER 21</span><span class="edition">WATCH THE CURVES · TEST THE CAUSE</span></div>
    <h1>Train and debug.<br/><em>Learn from the curves.</em></h1>
    <p class="hero-description">Choose a training setup, diagnose failed learning,<br class="desktop-break"/> and keep a model that earns its validation result.</p>
    <div class="chapter-meta"><span><i aria-hidden="true">◷</i> 20–25 min core reading</span><span>25–35 min practice</span><span>12 short sections</span></div>
    <div class="hero-actions screen-only"><a href="#1-define-the-experiment-before-training" class="primary-button">Start learning <span>↓</span></a><a class="text-button" href="/downloads/ai-handbook-chapter-21.pdf" download>Download PDF <span>↗</span></a><button class="text-button" id="print-chapter">Print chapter</button></div>
    <div class="hero-illustration" aria-hidden="true"><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="orbit orbit-three"></div><span class="orbit-node n1"></span><span class="orbit-node n2"></span><span class="orbit-node n3"></span><span class="orbit-label">TRAIN → DIAGNOSE → COMPARE</span></div>
  </header>
  <div class="reader-tools screen-only"><button id="save-place" class="small-button">Bookmark this section</button><a id="resume-place" hidden>Resume saved section →</a><details class="reader-options"><summary>More reading tools</summary><div class="reader-tools-inner"><span class="local-note">Progress is saved in this browser.</span><div class="backup-actions"><button id="export-progress" class="small-button">Export progress</button><label class="small-button" for="import-progress">Import progress<input id="import-progress" type="file" accept="application/json"/></label></div></div></details></div>
  <div class="chapter-content"><Chapter /></div>
  <section class="completion-card screen-only" aria-labelledby="completion-title"><span class="eyebrow">PAUSE. EXPLAIN. CONNECT.</span><h2 id="completion-title">Can you explain why a training run improved?</h2><p>Name the evidence, check the data boundary, and distinguish the last epoch from the selected checkpoint.</p><button id="complete-chapter" class="primary-button" aria-pressed="false">Mark Chapter 21 complete</button><p id="completion-status" class="local-note">Your completion status is saved only in this browser.</p></section>
  <footer class="chapter-end"><div><span class="eyebrow">NEXT IN THE HANDBOOK</span><h3>CNNs, sequence models, and transfer learning</h3><p>Match architectures to images and sequences, then reuse learned representations.</p><a class="text-button" href="/chapters/20-neural-networks-from-first-principles/">← Revisit Chapter 20</a></div><a class="primary-button" href="/chapters/22-cnns-sequence-models-and-transfer-learning/">Read Chapter 22 →</a></footer>
  <div class="edition-footer">AI, understood · Personal learning edition · Chapter 21 · About {(Math.round(words/100)*100).toLocaleString()} words</div>
</BookLayout>
