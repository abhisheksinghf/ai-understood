---
import BookLayout from '../../layouts/BookLayout.astro';
import Chapter, { getHeadings } from '../../content/chapter-08.mdx';
import raw from '../../content/chapter-08.mdx?raw';
const headings=getHeadings();
const chunks=raw.split(/^## /m).slice(1);
const searchSections=headings.filter(h=>h.depth===2).map((h,i)=>({title:h.text,slug:h.slug,body:(chunks[i]||'').split('\n').slice(1).join(' ').replace(/<[^>]+>/g,' ').replace(/[`*#|]/g,'').replace(/\s+/g,' ').trim()}));
const words=raw.replace(/<[^>]+>/g,' ').split(/\s+/).filter(Boolean).length;
---
<BookLayout title="Calculus, optimization, and information theory" chapter chapterNumber={8} headings={headings} searchSections={searchSections} tocTitles={["Derivatives & change","Partial derivatives & gradients","Chain rule & backpropagation","Explore gradient descent","Optimization in practice","Integration & accumulation","Surprise & entropy","Cross-entropy & KL","From probability to updates","Practice exercises","Knowledge check","Revision & connections"]} searchPlaceholder="Try “chain rule”, “entropy”, or “momentum”…">
  <div class="breadcrumb"><a href="/curriculum/">Handbook</a><span>/</span><span>Part 02 · Mathematical foundations</span></div>
  <header class="chapter-hero">
    <div class="hero-kicker"><span class="chapter-pill">CHAPTER 08</span><span class="edition">UNDERSTAND THE MATHEMATICS OF LEARNING</span></div>
    <h1>Calculus, optimization<br/><em>&amp; information theory.</em></h1>
    <p class="hero-description">Measure change. Improve a prediction.<br class="desktop-break"/> Connect gradients, probability, and the objectives behind learning.</p>
    <div class="chapter-meta"><span><i aria-hidden="true">◷</i> 25–30 min core reading</span><span>Build on Chapters 6–7</span><span>12 short sections</span></div>
    <div class="hero-actions screen-only"><a href="#1-measure-how-fast-a-function-changes" class="primary-button">Start learning <span>↓</span></a><a class="text-button" href="/downloads/ai-handbook-chapter-08.pdf" download>Download PDF <span>↗</span></a><button class="text-button" id="print-chapter">Print chapter</button></div>
    <div class="hero-illustration" aria-hidden="true"><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="orbit orbit-three"></div><span class="orbit-node n1"></span><span class="orbit-node n2"></span><span class="orbit-node n3"></span><span class="orbit-label">NAME → CALCULATE → INTERPRET</span></div>
  </header>
  <div class="reader-tools screen-only"><button id="save-place" class="small-button">Bookmark this section</button><a id="resume-place" hidden>Resume saved section →</a><details class="reader-options"><summary>More reading tools</summary><div class="reader-tools-inner"><span class="local-note">Progress is saved in this browser.</span><div class="backup-actions"><button id="export-progress" class="small-button">Export progress</button><label class="small-button" for="import-progress">Import progress<input id="import-progress" type="file" accept="application/json"/></label></div></div></details></div>
  <div class="chapter-content"><Chapter /></div>
  <section class="completion-card screen-only" aria-labelledby="completion-title"><span class="eyebrow">PAUSE. EXPLAIN. CONNECT.</span><h2 id="completion-title">Can you explain it in your own words?</h2><p>Follow the chain rule, calculate one gradient step, and explain the difference between entropy and cross-entropy. Use the workbook to check the numbers.</p><button id="complete-chapter" class="primary-button" aria-pressed="false">Mark Chapter 8 complete</button><p id="completion-status" class="local-note">Your completion status is saved only in this browser.</p></section>
  <footer class="chapter-end"><div><span class="eyebrow">NEXT IN THE HANDBOOK</span><h3>Prompting and context design</h3><p>Use clear instructions, useful context, and explicit output requirements.</p><a class="text-button" href="/chapters/07-probability-and-statistics/">← Revisit Chapter 7</a></div><a class="primary-button" href="/chapters/09-prompting-and-context-design/">Read Chapter 9 →</a></footer>
  <div class="edition-footer">AI, understood · Personal learning edition · Chapter 08 · About {(Math.round(words/100)*100).toLocaleString()} words</div>
</BookLayout>
