---
interface Props{kind:'vae'|'gan'|'diffusion'}
const {kind}=Astro.props,id='generation-'+kind;
const titles={vae:'One decoder. Two different starting points.',gan:'Train two networks. Sample with one.',diffusion:'Training knows the noise. Generation estimates a path.'};
const captions={vae:'Figure 1. Reconstruction encodes an existing poster and samples its latent distribution. New generation samples the prior and uses the learned decoder. The prior path needs no input poster.',gan:'Figure 2. During training, real and generated examples teach the discriminator; feedback through the discriminator teaches the generator. At inference, noise passes through the generator to produce a sample.',diffusion:'Figure 3. Training corrupts a known example and compares predicted noise with known noise. Sampling starts from noise and repeatedly uses estimates to update the state. There is no hidden original to recover.'};
const rows=kind==='vae'?[['Existing poster','Encoder → μ, σ','Sample latent z','Decoder → poster'],['Prior noise','Sample latent z','Same decoder','New poster']]:kind==='gan'?[['Noise z','Generator','Synthetic posters','Discriminator'],['Real posters','Discriminator','Learning signal','Update networks']]:[['Clean + noise','Corrupt at time t','Predict noise','Compare & learn'],['Starting noise','Denoiser + time','Sampler update','Repeat → sample']];
---
<figure class="diagram"><div class="figure-title"><span class="figure-icon" aria-hidden="true">↗</span>{titles[kind]}</div><div class="diagram-scroll" tabindex="0" role="region" aria-label={titles[kind]}><svg viewBox="0 0 760 270" role="img" aria-labelledby={`${id}-title ${id}-desc`}><title id={`${id}-title`}>{titles[kind]}</title><desc id={`${id}-desc`}>{captions[kind]}</desc><defs><marker id={`${id}-arrow`} markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto"><path d="M0 0 L8 4 L0 8Z" fill="var(--accent)"/></marker></defs>
{kind!=='gan'&&<>{rows.map((row,i)=><g><text x="20" y={i?161:24} fill="var(--muted)" font-size="13" letter-spacing="1">{kind==='vae'?(i?'NEW GENERATION':'RECONSTRUCTION'):(i?'SAMPLING · FIXED MODEL':'TRAINING · UPDATE MODEL')}</text>{row.map((label,j)=><g><rect x={20+j*187} y={i?176:40} width="159" height="64" rx="8" fill={j===1||j===2?'var(--accent-soft)':'var(--panel)'} stroke="var(--line)"/><text x={99.5+j*187} y={i?214:78} text-anchor="middle" fill="var(--ink)" font-size="15">{label}</text>{j<3&&<path d={`M${184+j*187} ${i?208:72} H${201+j*187}`} stroke="var(--accent)" stroke-width="2" marker-end={`url(#${id}-arrow)`}/>}</g>)}</g>)}<text x="380" y="132" text-anchor="middle" fill="var(--muted)" font-size="13">{kind==='vae'?'Training balances reconstruction with a prior-matching penalty.':'Training examples teach statistical estimates, not exact recovery of every original.'}</text></>}
{kind==='gan'&&<><text x="20" y="24" fill="var(--muted)" font-size="13" letter-spacing="1">GENERATED EXAMPLES DURING TRAINING</text>{rows[0].map((label,j)=><g><rect x={20+j*187} y="40" width="159" height="64" rx="8" fill={j===1?'var(--accent-soft)':'var(--panel)'} stroke="var(--line)"/><text x={99.5+j*187} y="78" text-anchor="middle" fill="var(--ink)" font-size="15">{label}</text>{j<3&&<path d={`M${184+j*187} 72 H${201+j*187}`} stroke="var(--accent)" stroke-width="2" marker-end={`url(#${id}-arrow)`}/>}</g>)}<path d="M640 108 V132 H287 V110" fill="none" stroke="var(--accent)" stroke-width="2" stroke-dasharray="5 4" marker-end={`url(#${id}-arrow)`}/><text x="460" y="157" text-anchor="middle" fill="var(--muted)" font-size="13">Gradient feedback to the generator</text><rect x="20" y="176" width="159" height="64" rx="8" fill="var(--panel)" stroke="var(--line)"/><text x="99.5" y="214" text-anchor="middle" fill="var(--ink)" font-size="15">Real posters</text><path d="M184 208 H690 V110" fill="none" stroke="var(--accent)" stroke-width="2" marker-end={`url(#${id}-arrow)`}/><text x="430" y="197" text-anchor="middle" fill="var(--muted)" font-size="13">Real + generated examples train the discriminator</text><text x="430" y="253" text-anchor="middle" fill="var(--muted)" font-size="13">Inference: noise → generator → sample</text></>}
</svg></div><figcaption>{captions[kind]}</figcaption></figure>
