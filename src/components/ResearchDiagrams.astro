---
type Kind='reading'|'audit'|'agi';
const {kind}=Astro.props as {kind:Kind};
const id=`research-${kind}`,arrow=`url(#${id}-arrow)`;
const titles={reading:'Follow the path from a claim to its supporting evidence.',audit:'Keep the comparison paired when you audit the cases.',agi:'Performance, generality, and autonomy answer different questions.'};
const captions={reading:'Figure 1. Read with increasing depth. The final conclusion should retain the task, comparison, protocol, and limitations found in the evidence.',audit:'Figure 2. Removing the same four overlap cases changes both denominators. The reversal reveals sensitivity to the evaluated set; it does not establish why the systems behaved differently.',agi:'Figure 3. A capability profile needs several dimensions. Broadening action permissions does not by itself demonstrate broader competence. These panels illustrate questions, not an AGI scoring scale.'};
---
<figure class="diagram"><div class="figure-title"><span class="figure-icon" aria-hidden="true">↗</span>{titles[kind]}</div><div class="diagram-scroll" tabindex="0" role="region" aria-label={titles[kind]}><svg viewBox="0 0 760 270" role="img" aria-labelledby={`${id}-title ${id}-desc`}><title id={`${id}-title`}>{titles[kind]}</title><desc id={`${id}-desc`}>{captions[kind]}</desc><defs><marker id={`${id}-arrow`} markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto"><path d="M0 0 L8 4 L0 8Z" fill="var(--accent)"/></marker></defs>
{kind==='reading'&&<>
{[['Orient','What is being claimed?'],['Inspect','How was it measured?'],['Reconstruct','Can I explain or repeat it?']].map(([title,sub],i)=><g><rect x={20+i*248} y="47" width="220" height="106" rx="8" fill={i===1?'var(--accent-soft)':'var(--panel)'} stroke="var(--line)"/><text x={130+i*248} y="88" text-anchor="middle" fill="var(--ink)" font-size="19">{title}</text><text x={130+i*248} y="121" text-anchor="middle" fill="var(--muted)" font-size="14">{sub}</text>{i<2&&<path d={`M${243+i*248} 100 H${263+i*248}`} stroke="var(--accent)" stroke-width="2" marker-end={arrow}/>}</g>)}
<text x="380" y="207" text-anchor="middle" fill="var(--ink)" font-size="16">Write a bounded conclusion: result + conditions + remaining uncertainty.</text><text x="380" y="235" text-anchor="middle" fill="var(--muted)" font-size="13">A headline is a starting point. The evidence determines the scope.</text>
</>}
{kind==='audit'&&<>
{[['Full toy set','12 shared cases','Baseline: 6 / 12 = 50%','Candidate: 9 / 12 = 75%','Candidate difference: +25 pp'],['After excluding overlap','8 shared cases','Baseline: 6 / 8 = 75%','Candidate: 5 / 8 = 62.5%','Candidate difference: −12.5 pp']].map(([title,sub,a,b,d],i)=><g><rect x={20+i*430} y="24" width="290" height="199" rx="8" fill="var(--panel)" stroke="var(--line)"/><text x={165+i*430} y="56" text-anchor="middle" fill="var(--ink)" font-size="17">{title}</text><text x={165+i*430} y="83" text-anchor="middle" fill="var(--muted)" font-size="14">{sub}</text><text x={165+i*430} y="120" text-anchor="middle" fill="var(--ink)" font-size="15">{a}</text><text x={165+i*430} y="153" text-anchor="middle" fill="var(--ink)" font-size="15">{b}</text><text x={165+i*430} y="196" text-anchor="middle" fill="var(--accent)" font-size="14">{d}</text></g>)}
<path d="M320 126 H439" stroke="var(--accent)" stroke-width="2" marker-end={arrow}/><text x="379" y="100" text-anchor="middle" fill="var(--muted)" font-size="12">Exclude same 4</text><text x="380" y="253" text-anchor="middle" fill="var(--muted)" font-size="13">Unflagged does not mean certified unseen. The evaluated population has changed.</text>
</>}
{kind==='agi'&&<>
{[['Performance','How well?','Answer catalog questions','to a specified standard.'],['Generality','Across what range?','Transfer to unfamiliar tasks','with stated learning resources.'],['Autonomy','With how much oversight?','Suggest a movie, or act','without confirmation.']].map(([title,question,a,b],i)=><g><rect x={20+i*248} y="26" width="220" height="191" rx="8" fill={i===1?'var(--accent-soft)':'var(--panel)'} stroke="var(--line)"/><text x={130+i*248} y="62" text-anchor="middle" fill="var(--ink)" font-size="19">{title}</text><text x={130+i*248} y="98" text-anchor="middle" fill="var(--accent)" font-size="15">{question}</text><text x={130+i*248} y="146" text-anchor="middle" fill="var(--muted)" font-size="13">{a}</text><text x={130+i*248} y="169" text-anchor="middle" fill="var(--muted)" font-size="13">{b}</text></g>)}
<text x="380" y="252" text-anchor="middle" fill="var(--ink)" font-size="14">An excellent specialist and a highly autonomous system need not be broadly capable.</text>
</>}
</svg></div><figcaption>{captions[kind]}</figcaption></figure>
