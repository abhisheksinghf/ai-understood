---
interface Props{kind:'loop'|'workflow'|'retry'}
const {kind}=Astro.props,id='workflow-'+kind;
const titles={loop:'A request leaves the model. A result comes back.',workflow:'A known path with explicit exits.',retry:'Two attempts. One protected write.'};
const captions={loop:'Figure 1. The model proposes a call; the application validates it and invokes the permitted tool. The returned result is linked to the call ID before the model continues. The execution boundary remains in application code.',workflow:'Figure 2. The write depends on a successful lookup, the regional availability condition, account permission, and exact user intent. Each failed condition has an exit. A save receipt supports the final success message.',retry:'Figure 3. The first save commits but its response is lost. A retry with the same operation key receives the stored receipt without a second append. This relies on the service implementing deduplication.'};
---
<figure class="diagram"><div class="figure-title"><span class="figure-icon" aria-hidden="true">↗</span>{titles[kind]}</div><div class="diagram-scroll" tabindex="0" role="region" aria-label={titles[kind]}><svg viewBox="0 0 760 285" role="img" aria-labelledby={`${id}-title ${id}-desc`}><title id={`${id}-title`}>{titles[kind]}</title><desc id={`${id}-desc`}>{captions[kind]}</desc><defs><marker id={`${id}-arrow`} markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto"><path d="M0 0 L8 4 L0 8Z" fill="var(--accent)"/></marker></defs>
{kind==='loop'&&<>{[['Model','Propose a tool call'],['Application','Validate + authorize'],['Tool handler','Execute permitted code']].map(([title,sub],i)=><g><rect x={30+i*250} y="57" width="200" height="82" rx="8" fill={i===1?'var(--accent-soft)':'var(--panel)'} stroke="var(--line)"/><text x={130+i*250} y="90" text-anchor="middle" fill="var(--ink)" font-size="17">{title}</text><text x={130+i*250} y="115" text-anchor="middle" fill="var(--muted)" font-size="14">{sub}</text>{i<2&&<path d={`M${237+i*250} 97 H${267+i*250}`} stroke="var(--accent)" stroke-width="2" marker-end={`url(#${id}-arrow)`}/>}</g>)}<path d="M630 147 V211 H130 V150" fill="none" stroke="var(--accent)" stroke-width="2" marker-end={`url(#${id}-arrow)`}/><text x="380" y="193" text-anchor="middle" fill="var(--ink)" font-size="15">Application returns checked result + call ID</text><text x="380" y="258" text-anchor="middle" fill="var(--muted)" font-size="14">The model can answer or request another tool.</text></>}
{kind==='workflow'&&<>{[['Lookup','Movie + region'],['Condition','Available here?'],['Write gate','Permission + intent'],['Save','Verify receipt']].map(([title,sub],i)=><g><rect x={20+i*187} y="43" width="158" height="82" rx="8" fill={i===2?'var(--accent-soft)':'var(--panel)'} stroke="var(--line)"/><text x={99+i*187} y="76" text-anchor="middle" fill="var(--ink)" font-size="17">{title}</text><text x={99+i*187} y="102" text-anchor="middle" fill="var(--muted)" font-size="13">{sub}</text>{i<3&&<path d={`M${183+i*187} 84 H${201+i*187}`} stroke="var(--accent)" stroke-width="2" marker-end={`url(#${id}-arrow)`}/>}<path d={`M${99+i*187} 133 V175`} stroke="var(--accent)" stroke-width="2" marker-end={`url(#${id}-arrow)`}/><text x={99+i*187} y="207" text-anchor="middle" fill="var(--muted)" font-size="13">{['Invalid / failed','Unavailable','Denied / changed','Success / uncertain'][i]}</text></g>)}<text x="380" y="258" text-anchor="middle" fill="var(--muted)" font-size="14">Continue only when the previous step establishes the required condition.</text></>}
{kind==='retry'&&<><text x="132" y="29" text-anchor="middle" fill="var(--ink)" font-size="17">Application</text><text x="578" y="29" text-anchor="middle" fill="var(--ink)" font-size="17">Watchlist service</text><path d="M132 44 V266 M578 44 V266" stroke="var(--line)" stroke-width="2"/>{[[70,'Save M001 · key K'],[180,'Retry M001 · same key K']].map(([y,label])=><g><path d={`M140 ${y} H568`} stroke="var(--accent)" stroke-width="2" marker-end={`url(#${id}-arrow)`}/><text x="350" y={Number(y)-11} text-anchor="middle" fill="var(--ink)" font-size="14">{label}</text></g>)}<path d="M568 127 H230" stroke="var(--gold)" stroke-width="2" stroke-dasharray="5 4"/><text x="204" y="133" text-anchor="middle" fill="var(--ink)" font-size="21">×</text><text x="350" y="114" text-anchor="middle" fill="var(--muted)" font-size="14">Receipt lost</text><text x="653" y="89" text-anchor="middle" fill="var(--muted)" font-size="13">Append once</text><path d="M568 238 H142" stroke="var(--accent)" stroke-width="2" marker-end={`url(#${id}-arrow)`}/><text x="350" y="225" text-anchor="middle" fill="var(--ink)" font-size="14">Replay original receipt</text><text x="653" y="199" text-anchor="middle" fill="var(--muted)" font-size="13">No new append</text></>}
</svg></div><figcaption>{captions[kind]}</figcaption></figure>
