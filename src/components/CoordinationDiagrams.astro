---
interface Props{kind:'connection'|'ownership'|'dependencies'}
const {kind}=Astro.props,id='coord-'+kind;
const titles={connection:'One host. Separate server connections.',ownership:'Helping with a reply or taking ownership of it.',dependencies:'Search first. Independent checks can overlap.'};
const captions={connection:'Figure 1. The host manages model context and policy. Each client connects to a server that exposes capabilities. MCP servers can wrap ordinary APIs without containing an agent.',ownership:'Figure 2. In manager mode, helper results return to the manager. In handoff mode, a movie specialist takes control and owns the next reply. Both designs still need bounded scope and checked evidence.',dependencies:'Figure 3. Candidate IDs come from search. Availability and taste checks can then overlap. The final step waits for both required reports. Time units are fictional; work is unchanged by overlap.'};
const arrow=`url(#${id}-arrow)`;
---
<figure class="diagram"><div class="figure-title"><span class="figure-icon" aria-hidden="true">↗</span>{titles[kind]}</div><div class="diagram-scroll" tabindex="0" role="region" aria-label={titles[kind]}><svg viewBox="0 0 760 310" role="img" aria-labelledby={`${id}-title ${id}-desc`}><title id={`${id}-title`}>{titles[kind]}</title><desc id={`${id}-desc`}>{captions[kind]}</desc><defs><marker id={`${id}-arrow`} markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto"><path d="M0 0 L8 4 L0 8Z" fill="var(--accent)"/></marker></defs>
{kind==='connection'&&<>
 <rect x="20" y="20" width="415" height="265" rx="12" fill="var(--panel)" stroke="var(--line)"/><text x="42" y="52" fill="var(--ink)" font-size="17">Host: movie assistant application</text>
 <rect x="40" y="92" width="150" height="120" rx="8" fill="var(--accent-soft)" stroke="var(--line)"/><text x="115" y="128" text-anchor="middle" fill="var(--ink)" font-size="15">Model + context</text><text x="115" y="158" text-anchor="middle" fill="var(--muted)" font-size="13">Permissions</text><text x="115" y="183" text-anchor="middle" fill="var(--muted)" font-size="13">Routing + checks</text>
 {[['Catalog client','Catalog server','Movie database',82],['Availability client','Availability server','Regional listings',197]].map(([client,server,sub,y])=><g><rect x="237" y={y} width="176" height="60" rx="7" fill="var(--paper)" stroke="var(--line)"/><text x="325" y={Number(y)+36} text-anchor="middle" fill="var(--ink)" font-size="14">{client}</text><rect x="531" y={Number(y)-9} width="205" height="80" rx="8" fill="var(--panel)" stroke="var(--line)"/><text x="633.5" y={Number(y)+21} text-anchor="middle" fill="var(--ink)" font-size="15">{server}</text><text x="633.5" y={Number(y)+47} text-anchor="middle" fill="var(--muted)" font-size="13">{sub}</text><path d={`M423 ${Number(y)+30} H520`} stroke="var(--accent)" stroke-width="2" marker-end={arrow}/><text x="473" y={Number(y)+17} text-anchor="middle" fill="var(--muted)" font-size="12">MCP</text></g>)}
 <path d="M197 130 H210 V112 H228" fill="none" stroke="var(--accent)" stroke-width="2" marker-end={arrow}/><path d="M197 174 H210 V227 H228" fill="none" stroke="var(--accent)" stroke-width="2" marker-end={arrow}/>
 </>}
{kind==='ownership'&&<>
 <text x="22" y="34" fill="var(--muted)" font-size="13">MANAGER: helper returns a report</text><text x="22" y="188" fill="var(--muted)" font-size="13">HANDOFF: specialist takes control</text>
 {[['Manager','Specialist helper','Manager replies',54],['General assistant','Movie specialist','Specialist replies',208]].map(([a,b,c,y])=><g>{[a,b,c].map((label,i)=><g><rect x={22+i*255} y={y} width="205" height="65" rx="8" fill={i===2?'var(--accent-soft)':'var(--panel)'} stroke="var(--line)"/><text x={124.5+i*255} y={Number(y)+38} text-anchor="middle" fill="var(--ink)" font-size="15">{label}</text>{i<2&&<path d={`M${236+i*255} ${Number(y)+32} H${266+i*255}`} stroke="var(--accent)" stroke-width="2" marker-end={arrow}/>}</g>)}</g>)}
 <text x="380" y="145" text-anchor="middle" fill="var(--muted)" font-size="13">Reply ownership stays with the manager.</text><text x="380" y="298" text-anchor="middle" fill="var(--muted)" font-size="13">Carry constraints, evidence, and remaining budget.</text>
 </>}
{kind==='dependencies'&&<>
 <rect x="22" y="106" width="168" height="88" rx="8" fill="var(--panel)" stroke="var(--line)"/><text x="106" y="139" text-anchor="middle" fill="var(--ink)" font-size="16">Catalog search</text><text x="106" y="168" text-anchor="middle" fill="var(--muted)" font-size="13">0–2: candidate IDs</text>
 {[['Availability','2–5: 3 units',39],['Taste ranking','2–4: 2 units',181]].map(([a,b,y])=><g><rect x="300" y={y} width="173" height="85" rx="8" fill="var(--accent-soft)" stroke="var(--line)"/><text x="386.5" y={Number(y)+34} text-anchor="middle" fill="var(--ink)" font-size="16">{a}</text><text x="386.5" y={Number(y)+62} text-anchor="middle" fill="var(--muted)" font-size="13">{b}</text></g>)}
 <path d="M198 134 H244 V81 H290" fill="none" stroke="var(--accent)" stroke-width="2" marker-end={arrow}/><path d="M198 165 H244 V223 H290" fill="none" stroke="var(--accent)" stroke-width="2" marker-end={arrow}/><path d="M481 81 H526 V133 H564" fill="none" stroke="var(--accent)" stroke-width="2" marker-end={arrow}/><path d="M481 223 H526 V168 H564" fill="none" stroke="var(--accent)" stroke-width="2" marker-end={arrow}/>
 <rect x="575" y="106" width="163" height="88" rx="8" fill="var(--panel)" stroke="var(--line)"/><text x="656.5" y="139" text-anchor="middle" fill="var(--ink)" font-size="16">Verify + reply</text><text x="656.5" y="168" text-anchor="middle" fill="var(--muted)" font-size="13">5–6: 1 unit</text><text x="380" y="299" text-anchor="middle" fill="var(--muted)" font-size="13">Elapsed: 6 units · Total work: 8 units</text>
 </>}
</svg></div><figcaption>{captions[kind]}</figcaption></figure>

