---
interface Props{kind:'boundary'|'action'|'responsibility'}
const {kind}=Astro.props,id='security-'+kind;
const titles={boundary:'Useful evidence can contain unwanted instructions.',action:'Permission comes from trusted application state.',responsibility:'Responsible use is an ongoing process.'};
const captions={boundary:'Figure 1. Reviews enter as untrusted evidence. A model may still propose the wrong action. The application checks each proposed action before any tool runs; source text cannot grant permission.',action:'Figure 2. A watchlist addition needs the right account, requested movie, and matching confirmation under this example policy. Changing the movie or reusing an old request approval stops execution.',responsibility:'Figure 3. Identify the people affected, measure relevant outcomes, act on failures, and assign ownership. Repeat as usage and evidence change.'};
const arrow=`url(#${id}-arrow)`;
const boxes=kind==='boundary'?[['Review / file','Untrusted evidence'],['Model','Proposes an action'],['Policy checks','Trusted host state'],['Tool','Scoped execution']]:kind==='action'?[['Identity','Current account'],['Intent','Requested movie'],['Confirmation','Exact action + request'],['Execute','Check result once']]:[['Map','Who can be affected?'],['Measure','Quality + harm + gaps'],['Manage','Fix, limit, or stop'],['Govern','Owner + review path']];
---
<figure class="diagram"><div class="figure-title"><span class="figure-icon" aria-hidden="true">↗</span>{titles[kind]}</div><div class="diagram-scroll" tabindex="0" role="region" aria-label={titles[kind]}><svg viewBox="0 0 760 270" role="img" aria-labelledby={`${id}-title ${id}-desc`}><title id={`${id}-title`}>{titles[kind]}</title><desc id={`${id}-desc`}>{captions[kind]}</desc><defs><marker id={`${id}-arrow`} markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto"><path d="M0 0 L8 4 L0 8Z" fill="var(--accent)"/></marker></defs>
{boxes.map(([label,sub],i)=><g><rect x={18+i*188} y="50" width="160" height="86" rx="8" fill={i===2?'var(--accent-soft)':'var(--panel)'} stroke="var(--line)"/><text x={98+i*188} y="84" text-anchor="middle" fill="var(--ink)" font-size="15">{label}</text><text x={98+i*188} y="111" text-anchor="middle" fill="var(--muted)" font-size="12">{sub}</text>{i<3&&<path d={`M${181+i*188} 93 H${199+i*188}`} stroke="var(--accent)" stroke-width="2" marker-end={arrow}/>}</g>)}
{kind==='boundary'&&<><path d="M98 145 V180 H474 V145" fill="none" stroke="var(--accent)" stroke-width="2" stroke-dasharray="5 4"/><text x="380" y="214" text-anchor="middle" fill="var(--ink)" font-size="15">A review cannot change identity, intent, or permissions.</text><text x="380" y="248" text-anchor="middle" fill="var(--muted)" font-size="13">Prompt instructions help; execution checks enforce the boundary.</text></>}
{kind==='action'&&<><path d="M98 145 V180 H662 V145" fill="none" stroke="var(--accent)" stroke-width="2"/><text x="380" y="213" text-anchor="middle" fill="var(--ink)" font-size="15">Mismatch → stop or request a valid confirmation</text><text x="380" y="246" text-anchor="middle" fill="var(--muted)" font-size="13">A model-generated “approved: true” is still untrusted output.</text></>}
{kind==='responsibility'&&<><path d="M662 145 V211 H98 V147" fill="none" stroke="var(--accent)" stroke-width="2" stroke-dasharray="5 4" marker-end={arrow}/><text x="380" y="188" text-anchor="middle" fill="var(--ink)" font-size="14">Feedback and new evidence update the next review.</text><text x="380" y="250" text-anchor="middle" fill="var(--muted)" font-size="13">Governance spans every step; these activities are not a one-time checklist.</text></>}
</svg></div><figcaption>{captions[kind]}</figcaption></figure>
