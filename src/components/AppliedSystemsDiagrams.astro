---
type Kind='vision'|'recommend'|'time';
const {kind}=Astro.props as {kind:Kind};
const id=`applied-${kind}`,arrow=`url(#${id}-arrow)`;
const titles={vision:'One image can support different prediction tasks.',recommend:'Retrieve candidates. Score them. Build the list.',time:'Recreate what was known at each forecast origin.'};
const captions={vision:'Figure 1. Classification assigns a label to an image; detection encloses each object; instance segmentation identifies each object’s pixels. These drawings illustrate target types, not a model’s output.',recommend:'Figure 2. A practical recommender narrows the catalog, ranks candidates, and applies list-level rules. Eligibility can be enforced at several stages. The lab starts with the full eligible pool and evaluates its final ordering.',time:'Figure 3. Each row is a separate one-day-ahead forecast. Observations become available as time advances. A day-15 outcome may inform the next row, but cannot enter the forecast that predicted day 15.'};
---
<figure class="diagram"><div class="figure-title"><span class="figure-icon" aria-hidden="true">↗</span>{titles[kind]}</div><div class="diagram-scroll" tabindex="0" role="region" aria-label={titles[kind]}><svg viewBox="0 0 760 270" role="img" aria-labelledby={`${id}-title ${id}-desc`}><title id={`${id}-title`}>{titles[kind]}</title><desc id={`${id}-desc`}>{captions[kind]}</desc><defs><marker id={`${id}-arrow`} markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto"><path d="M0 0 L8 4 L0 8Z" fill="var(--accent)"/></marker></defs>
{kind==='vision'&&<>
{['Classification','Detection','Instance segmentation'].map((title,i)=><g>
<rect x={20+i*250} y="28" width="220" height="172" rx="8" fill="var(--panel)" stroke="var(--line)"/>
<text x={130+i*250} y="54" text-anchor="middle" fill="var(--ink)" font-size="15">{title}</text>
<rect x={49+i*250} y="79" width="58" height="88" rx="4" fill={i===2?'var(--accent-soft)':'var(--paper)'} stroke="var(--line)"/>
<rect x={133+i*250} y="95" width="71" height="63" rx="4" fill={i===2?'color-mix(in srgb, var(--gold) 16%, var(--paper))':'var(--paper)'} stroke="var(--line)"/>
<path d={`M${58+i*250} 151 L${78+i*250} 110 L${97+i*250} 151Z`} fill="var(--line)"/>
<circle cx={168+i*250} cy="125" r="19" fill="var(--line)"/>
{i===1&&<><rect x="295" y="75" width="66" height="96" fill="none" stroke="var(--accent)" stroke-width="2"/><rect x="379" y="91" width="79" height="71" fill="none" stroke="var(--accent)" stroke-width="2"/></>}
{i===2&&<><rect x="549" y="79" width="58" height="88" rx="4" fill="var(--accent)" opacity=".2"/><rect x="633" y="95" width="71" height="63" rx="4" fill="var(--gold)" opacity=".25"/></>}
<text x={130+i*250} y="226" text-anchor="middle" fill="var(--ink)" font-size="13">{['“Poster display”','Two boxes + classes','A separate mask per poster'][i]}</text>
</g>)}
</>}
{kind==='recommend'&&<>
{[['Catalog','All movie records'],['Candidates','Potential matches'],['Ranked items','Score for this viewer'],['Final list','Variety + constraints']].map(([title,sub],i)=><g>
<rect x={18+i*188} y="55" width="160" height="100" rx="8" fill={i===2?'var(--accent-soft)':'var(--panel)'} stroke="var(--line)"/><text x={98+i*188} y="94" text-anchor="middle" fill="var(--ink)" font-size="16">{title}</text><text x={98+i*188} y="124" text-anchor="middle" fill="var(--muted)" font-size="12">{sub}</text>
{i<3&&<path d={`M${181+i*188} 105 H${199+i*188}`} stroke="var(--accent)" stroke-width="2" marker-end={arrow}/>}</g>)}
<path d="M286 159 V190 H662 V159" fill="none" stroke="var(--line)" stroke-width="2"/><text x="475" y="223" text-anchor="middle" fill="var(--ink)" font-size="14">Evaluate retrieval coverage and the final top-K ordering.</text>
</>}
{kind==='time'&&<>
{['Through day 14','Day 15','Day 16','Day 17'].map((t,i)=><text x={220+i*140} y="33" text-anchor="middle" fill="var(--ink)" font-size="14">{t}</text>)}
{[14,15,16].map((origin,row)=><g><text x="18" y={82+row*56} fill="var(--ink)" font-size="14">Origin: day {origin}</text>{[0,1,2,3].map((col)=><g><rect x={155+col*140} y={55+row*56} width="130" height="40" rx="5" fill={col<=row?'var(--accent-soft)':col===row+1?'color-mix(in srgb, var(--gold) 16%, var(--paper))':'var(--panel)'} stroke="var(--line)"/><text x={220+col*140} y={80+row*56} text-anchor="middle" fill="var(--ink)" font-size="13">{col<=row?'Observed':col===row+1?'Predict next':'Unknown'}</text></g>)}</g>)}
<text x="380" y="251" text-anchor="middle" fill="var(--muted)" font-size="13">The origin advances only after the next observation becomes available.</text>
</>}
</svg></div><figcaption>{captions[kind]}</figcaption></figure>
