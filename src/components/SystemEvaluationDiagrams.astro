---
interface Props{kind:'system'|'graders'|'gate'}
const {kind}=Astro.props,id='eval-'+kind;
const titles={system:'Measure the system around the model.',graders:'Different properties need different evidence.',gate:'An average is a starting point for investigation.'};
const captions={system:'Figure 1. The user experiences a complete chain. Inspect retrieved evidence, supplied context, model output, tool execution, and resulting state. Check the original request across the entire path.',graders:'Figure 2. Precise contracts suit executable checks; open-ended quality needs a rubric and reviewed judgments. Keep the dimensions separate before applying the acceptance rules.',gate:'Figure 3. Candidate improves overall but regresses on two action trials. Paired comparison identifies them; a hard no-unauthorized-write gate prevents other successes from hiding the problem.'};
const arrow=`url(#${id}-arrow)`;
const boxes=kind==='system'?[['Request','Goal + constraints'],['Evidence','Retrieval + context'],['Model + tools','Proposals + actions'],['Outcome','Reply + final state']]:kind==='gate'?[['Compare','10/16 → 12/16'],['Inspect pairs','4 wins · 2 losses'],['Apply gates','2 unauthorized writes'],['Decision','Hold for review']]:[];
---
<figure class="diagram"><div class="figure-title"><span class="figure-icon" aria-hidden="true">↗</span>{titles[kind]}</div><div class="diagram-scroll" tabindex="0" role="region" aria-label={titles[kind]}><svg viewBox="0 0 760 270" role="img" aria-labelledby={`${id}-title ${id}-desc`}><title id={`${id}-title`}>{titles[kind]}</title><desc id={`${id}-desc`}>{captions[kind]}</desc><defs><marker id={`${id}-arrow`} markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto"><path d="M0 0 L8 4 L0 8Z" fill="var(--accent)"/></marker></defs>
{boxes.map(([label,sub],i)=><g><rect x={18+i*188} y="50" width="160" height="86" rx="8" fill={i===2?'var(--accent-soft)':'var(--panel)'} stroke="var(--line)"/><text x={98+i*188} y="84" text-anchor="middle" fill="var(--ink)" font-size="15">{label}</text><text x={98+i*188} y="111" text-anchor="middle" fill="var(--muted)" font-size="12">{sub}</text>{i<3&&<path d={`M${181+i*188} 93 H${199+i*188}`} stroke="var(--accent)" stroke-width="2" marker-end={arrow}/>}</g>)}
{kind==='system'&&<><path d="M98 145 V184 H662 V145" fill="none" stroke="var(--accent)" stroke-width="2"/><text x="380" y="215" text-anchor="middle" fill="var(--ink)" font-size="15">Task success · Evidence · Permissions · Time · Cost</text><text x="380" y="247" text-anchor="middle" fill="var(--muted)" font-size="13">A fluent answer alone does not verify the whole task.</text></>}
{kind==='gate'&&<><path d="M662 145 V216 H98 V147" fill="none" stroke="var(--accent)" stroke-width="2" stroke-dasharray="5 4" marker-end={arrow}/><text x="380" y="193" text-anchor="middle" fill="var(--ink)" font-size="14">Inspect failure → fix behavior → rerun matched cases</text><text x="380" y="252" text-anchor="middle" fill="var(--muted)" font-size="13">Display filters do not change the release evidence.</text></>}
{kind==='graders'&&<>
 {[['Code checks','Fields, state, permissions'],['Rubric judgments','Usefulness, preference fit'],['Reviewed labels','Calibrate automated judges']].map(([label,sub],i)=><g><rect x={20+i*247} y="29" width="226" height="89" rx="8" fill={i===1?'var(--accent-soft)':'var(--panel)'} stroke="var(--line)"/><text x={133+i*247} y="65" text-anchor="middle" fill="var(--ink)" font-size="16">{label}</text><text x={133+i*247} y="93" text-anchor="middle" fill="var(--muted)" font-size="12.5">{sub}</text><path d={`M${133+i*247} 126 V155`} stroke="var(--accent)" stroke-width="2" marker-end={arrow}/></g>)}
 <rect x="20" y="166" width="720" height="71" rx="8" fill="var(--panel)" stroke="var(--line)"/><text x="380" y="195" text-anchor="middle" fill="var(--ink)" font-size="15">Separate scores + failures + supporting records</text><text x="380" y="220" text-anchor="middle" fill="var(--muted)" font-size="13">A style score cannot override a failed permission check.</text>
 </>}
</svg></div><figcaption>{captions[kind]}</figcaption></figure>
