---
interface Props{kind:'pipeline'|'ranking'|'evaluation'}
const {kind}=Astro.props;
const labels={pipeline:['Give each part one job','Figure 1. Application code validates preferences and catalog records, selects a movie, and builds a catalog-based card. Optional LLM prose travels through a separate validation and review path.'],ranking:['Filter first. Then compare eligible movies.','Figure 2. Hard constraints decide eligibility. The soft light-tone preference only orders eligible movies; it cannot rescue a movie that breaks a required constraint.'],evaluation:['Three questions need three kinds of evidence','Figure 3. Code tests check rules, task cases check complete outcomes, and viewer feedback checks usefulness. Passing prepared cases does not establish real-world enjoyment.']};
const id='project-'+kind;
---
<figure class="diagram"><div class="figure-title"><span class="figure-icon" aria-hidden="true">↗</span>{labels[kind][0]}</div><div class="diagram-scroll" tabindex="0" role="region" aria-label={labels[kind][0]}><svg viewBox={kind==='pipeline'?'0 0 760 260':'0 0 760 215'} role="img" aria-labelledby={id+'-title '+id+'-desc'}><title id={id+'-title'}>{labels[kind][0]}</title><desc id={id+'-desc'}>{labels[kind][1]}</desc><defs><marker id={id+'-arrow'} markerWidth="7" markerHeight="7" refX="6" refY="3.5" orient="auto"><path d="M0 0 L7 3.5 L0 7 Z" fill="var(--accent)"/></marker></defs>
{kind==='pipeline'&&<>
  {[['Preferences','genre, time, seen'],['Validate + select','rules over catalog'],['Catalog-based card','facts + template']].map(([name,detail],i)=><g><rect x={12+i*257} y="15" width="221" height="78" rx="7" class={i===1?'node node-accent':'node'}/><text x={122+i*257} y="46" text-anchor="middle" class="node-title">{name}</text><text x={122+i*257} y="71" text-anchor="middle" class="node-detail">{detail}</text></g>)}
  {[0,1].map(i=><line x1={239+i*257} x2={261+i*257} y1="54" y2="54" stroke="var(--accent)" stroke-width="2" marker-end={'url(#'+id+'-arrow)'}/>)}
  <path d="M379 94 V130 H182 V156" fill="none" stroke="var(--accent)" stroke-width="2" marker-end={'url(#'+id+'-arrow)'}/>
  <rect x="72" y="163" width="221" height="68" rx="7" class="node"/><text x="182" y="190" text-anchor="middle" class="node-title">Optional LLM draft</text><text x="182" y="212" text-anchor="middle" class="node-detail">selected facts + preferences</text>
  <line x1="300" x2="433" y1="197" y2="197" stroke="var(--accent)" stroke-width="2" marker-end={'url(#'+id+'-arrow)'}/>
  <rect x="442" y="163" width="251" height="68" rx="7" class="node"/><text x="567" y="190" text-anchor="middle" class="node-title">Validate, then review</text><text x="567" y="212" text-anchor="middle" class="node-detail">keep separate from catalog fields</text>
</>}
{kind==='ranking'&&<>
  {[['Hard constraints','genre + length + unseen'],['Soft preference','light tone: 1 or 0'],['Tie-break','shorter runtime, then ID']].map(([name,detail],i)=><g><rect x={12+i*257} y="28" width="221" height="86" rx="7" class={i===0?'node node-accent':'node'}/><text x={122+i*257} y="63" text-anchor="middle" class="node-title">{name}</text><text x={122+i*257} y="90" text-anchor="middle" class="node-detail">{detail}</text></g>)}
  {[0,1].map(i=><line x1={239+i*257} x2={261+i*257} y1="71" y2="71" stroke="var(--accent)" stroke-width="2" marker-end={'url(#'+id+'-arrow)'}/>)}
  <text x="380" y="158" text-anchor="middle" class="node-title">A 140-minute movie cannot satisfy a 120-minute limit.</text><text x="380" y="188" text-anchor="middle" class="node-detail">An unknown runtime cannot establish that the limit is satisfied either.</text>
</>}
{kind==='evaluation'&&<>
  {[['Code correctness','boundary + failure tests'],['Task behavior','fixed requests + expected IDs'],['Viewer usefulness','feedback + broader evaluation']].map(([name,detail],i)=><g><rect x={12+i*257} y="28" width="221" height="86" rx="7" class={i===2?'node node-accent':'node'}/><text x={122+i*257} y="63" text-anchor="middle" class="node-title">{name}</text><text x={122+i*257} y="90" text-anchor="middle" class="node-detail">{detail}</text></g>)}
  <text x="380" y="158" text-anchor="middle" class="node-title">“Meets the rules” and “a movie I enjoy” are different outcomes.</text><text x="380" y="188" text-anchor="middle" class="node-detail">Evaluate generated claims separately if you add an LLM explanation.</text>
</>}
</svg></div><figcaption>{labels[kind][1]}</figcaption></figure>
