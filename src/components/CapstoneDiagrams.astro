---
type Kind='architecture'|'trace'|'evaluation';
const {kind}=Astro.props as {kind:Kind};
const id=`capstone-${kind}`,arrow=`url(#${id}-arrow)`;
const titles={architecture:'One request. Explicit branches. Inspectable evidence.',trace:'Eligibility comes before the final recommendation.',evaluation:'Fix failures on development cases. Then seek new evidence.'};
const captions={architecture:'Figure 1. Validation routes a structured request to retrieval, a catalog lookup, or a tool fixture. Known evidence feeds the response template. An LLM can later replace a defined boundary, with its own checks.',trace:'Figure 2. Deep Orbit scores 2 but exceeds 110 minutes. Moonlight Map scores 1 and meets the limit. The improved path selects the eligible match; the flawed baseline selects the highest raw score.',evaluation:'Figure 3. Development results guide changes. Freeze the candidate before assessing separately authored evaluation cases. The eight visible workbook cases belong to development, not a hidden final test.'};
---
<figure class="diagram"><div class="figure-title"><span class="figure-icon" aria-hidden="true">↗</span>{titles[kind]}</div><div class="diagram-scroll" tabindex="0" role="region" aria-label={titles[kind]}><svg viewBox="0 0 760 270" role="img" aria-labelledby={`${id}-title ${id}-desc`}><title id={`${id}-title`}>{titles[kind]}</title><desc id={`${id}-desc`}>{captions[kind]}</desc><defs><marker id={`${id}-arrow`} markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto"><path d="M0 0 L8 4 L0 8Z" fill="var(--accent)"/></marker></defs>
{kind==='architecture'&&<>
<rect x="15" y="95" width="150" height="72" rx="8" fill="var(--panel)" stroke="var(--line)"/><text x="90" y="125" text-anchor="middle" fill="var(--ink)" font-size="17">Validate + route</text><text x="90" y="148" text-anchor="middle" fill="var(--muted)" font-size="12">Structured request</text>
{[['Recommend','Tags + hard filters'],['Runtime','Versioned catalog'],['Availability','Dated tool fixture']].map(([title,sub],i)=><g><rect x="230" y={15+i*83} width="228" height="69" rx="7" fill={i===0?'var(--accent-soft)':'var(--panel)'} stroke="var(--line)"/><text x="344" y={42+i*83} text-anchor="middle" fill="var(--ink)" font-size="17">{title}</text><text x="344" y={64+i*83} text-anchor="middle" fill="var(--muted)" font-size="13">{sub}</text><path d={`M165 131 H195 V${50+i*83} H220`} fill="none" stroke="var(--accent)" stroke-width="1.5" marker-end={arrow}/><path d={`M458 ${50+i*83} H495 V131 H539`} fill="none" stroke="var(--accent)" stroke-width="1.5" marker-end={arrow}/></g>)}
<rect x="548" y="95" width="195" height="72" rx="8" fill="var(--accent-soft)" stroke="var(--line)"/><text x="645" y="125" text-anchor="middle" fill="var(--ink)" font-size="17">Response template</text><text x="645" y="148" text-anchor="middle" fill="var(--muted)" font-size="12">Answer + sources + trace</text>
</>}
{kind==='trace'&&<>
{[['Deep Orbit','128 minutes · score 2','Exclude: exceeds limit'],['Moonlight Map','105 minutes · score 1','Eligible: select this film']].map(([title,sub,result],i)=><g><rect x={20+i*385} y="28" width="335" height="164" rx="8" fill={i?'var(--accent-soft)':'var(--panel)'} stroke="var(--line)"/><text x={187+i*385} y="64" text-anchor="middle" fill="var(--ink)" font-size="21">{title}</text><text x={187+i*385} y="103" text-anchor="middle" fill="var(--muted)" font-size="16">{sub}</text><text x={187+i*385} y="157" text-anchor="middle" fill="var(--accent)" font-size="16">{result}</text></g>)}
<text x="380" y="228" text-anchor="middle" fill="var(--ink)" font-size="16">Request: space adventure · at most 110 minutes · neither watched</text><text x="380" y="254" text-anchor="middle" fill="var(--muted)" font-size="13">Relevance scores rank eligible options. They do not grant exceptions.</text>
</>}
{kind==='evaluation'&&<>
{[['Develop','8 visible cases','Inspect → change → rerun'],['Freeze','Record configuration','Data + code + model versions'],['Evaluate','Separate new cases','Report failures and limits']].map(([title,sub,note],i)=><g><rect x={15+i*252} y="40" width="223" height="144" rx="8" fill={i===1?'var(--accent-soft)':'var(--panel)'} stroke="var(--line)"/><text x={126+i*252} y="77" text-anchor="middle" fill="var(--ink)" font-size="22">{title}</text><text x={126+i*252} y="115" text-anchor="middle" fill="var(--accent)" font-size="16">{sub}</text><text x={126+i*252} y="155" text-anchor="middle" fill="var(--muted)" font-size="12">{note}</text>{i<2&&<path d={`M${240+i*252} 112 H${262+i*252}`} stroke="var(--accent)" stroke-width="2" marker-end={arrow}/>}</g>)}
<text x="380" y="227" text-anchor="middle" fill="var(--ink)" font-size="16">Using a test result to tune the system turns it into development feedback.</text><text x="380" y="254" text-anchor="middle" fill="var(--muted)" font-size="13">Passing the demo gate is a learning milestone, not production certification.</text>
</>}
</svg></div><figcaption>{captions[kind]}</figcaption></figure>
