---
interface Props{kind:'gaps'|'runtime'|'hybrid'}
const {kind}=Astro.props;
const titles={gaps:'Ask what is missing before choosing a method.',runtime:'Context changes per request. Training changes parameters.',hybrid:'Evidence, live state, and actions play different roles.'};
const captions={gaps:'Figure 1. Match each observed gap to a candidate intervention. More than one can apply. Ordinary code should enforce exact filters and validations; fine-tuning is a measured trial for persistent behavior problems.',runtime:'Figure 2. Runtime context supplies instructions, examples, retrieved evidence, and tool results without ordinary inference updating weights. A separate training process produces an adapted checkpoint or adapter. Both paths still need evaluation.',hybrid:'Figure 3. A movie assistant combines archive evidence with current availability, applies exact filters, and explains the result. A watchlist change is a separate authorized operation whose actual result must be checked before claiming success.'};
const id='adaptation-'+kind;
const gaps=[['Unclear instructions','Prompt + examples'],['Missing document facts','Retrieve evidence'],['Live state or an action','Connect a tool'],['Stable behavior failure','Consider a training trial']];
---
<figure class="diagram"><div class="figure-title"><span class="figure-icon" aria-hidden="true">↗</span>{titles[kind]}</div><div class="diagram-scroll" tabindex="0" role="region" aria-label={titles[kind]}><svg viewBox={kind==='hybrid'?'0 0 760 330':'0 0 760 300'} role="img" aria-labelledby={`${id}-title ${id}-desc`}><title id={`${id}-title`}>{titles[kind]}</title><desc id={`${id}-desc`}>{captions[kind]}</desc><defs><marker id={`${id}-arrow`} markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto"><path d="M0,0 L8,4 L0,8 Z" fill="var(--accent)"/></marker></defs>
{kind==='gaps'&&<>{gaps.map(([gap,method],i)=><g><rect x="24" y={18+i*64} width="290" height="48" rx="7" fill="var(--panel)" stroke="var(--line)"/><text x="169" y={48+i*64} text-anchor="middle" fill="var(--ink)" font-size="16">{gap}</text><path d={`M326 ${42+i*64} H414`} stroke="var(--accent)" stroke-width="2" marker-end={`url(#${id}-arrow)`}/><rect x="430" y={18+i*64} width="306" height="48" rx="7" fill="var(--accent-soft)" stroke="var(--line)"/><text x="583" y={48+i*64} text-anchor="middle" fill="var(--ink)" font-size="16">{method}</text></g>)}<text x="380" y="292" text-anchor="middle" fill="var(--muted)" font-size="13">Combine only the roles your application needs.</text></>}
{kind==='runtime'&&<><rect x="24" y="22" width="220" height="92" rx="8" fill="var(--panel)" stroke="var(--line)"/><text x="134" y="52" text-anchor="middle" fill="var(--ink)" font-size="17">Runtime context</text><text x="134" y="78" text-anchor="middle" fill="var(--muted)" font-size="14">Prompt, facts, tool results</text><path d="M254 68 H312" stroke="var(--accent)" stroke-width="2" marker-end={`url(#${id}-arrow)`}/><rect x="328" y="22" width="178" height="92" rx="8" fill="var(--accent-soft)" stroke="var(--line)"/><text x="417" y="53" text-anchor="middle" fill="var(--ink)" font-size="17">Inference</text><text x="417" y="80" text-anchor="middle" fill="var(--muted)" font-size="14">Fixed model weights</text><path d="M516 68 H572" stroke="var(--accent)" stroke-width="2" marker-end={`url(#${id}-arrow)`}/><rect x="586" y="22" width="150" height="92" rx="8" fill="var(--panel)" stroke="var(--line)"/><text x="661" y="74" text-anchor="middle" fill="var(--ink)" font-size="17">Response</text><rect x="24" y="186" width="220" height="78" rx="8" fill="var(--panel)" stroke="var(--line)"/><text x="134" y="219" text-anchor="middle" fill="var(--ink)" font-size="17">Training examples</text><text x="134" y="244" text-anchor="middle" fill="var(--muted)" font-size="14">Curated demonstrations</text><path d="M254 225 H312" stroke="var(--accent)" stroke-width="2" marker-end={`url(#${id}-arrow)`}/><rect x="328" y="186" width="178" height="78" rx="8" fill="var(--accent-soft)" stroke="var(--line)"/><text x="417" y="219" text-anchor="middle" fill="var(--ink)" font-size="17">Fine-tuning</text><text x="417" y="244" text-anchor="middle" fill="var(--muted)" font-size="14">Update parameters</text><path d="M417 178 V124" stroke="var(--accent)" stroke-width="2" marker-end={`url(#${id}-arrow)`}/><text x="438" y="154" fill="var(--muted)" font-size="13">Evaluate, then deploy</text></>}
{kind==='hybrid'&&<><rect x="24" y="22" width="196" height="74" rx="8" fill="var(--panel)" stroke="var(--line)"/><text x="122" y="54" text-anchor="middle" fill="var(--ink)" font-size="16">Archive retrieval</text><text x="122" y="78" text-anchor="middle" fill="var(--muted)" font-size="14">Why a movie fits</text><rect x="24" y="126" width="196" height="74" rx="8" fill="var(--panel)" stroke="var(--line)"/><text x="122" y="158" text-anchor="middle" fill="var(--ink)" font-size="16">Live availability</text><text x="122" y="182" text-anchor="middle" fill="var(--muted)" font-size="14">Where / when / region</text><path d="M230 58 H268 V110 M230 164 H268 V110" fill="none" stroke="var(--accent)" stroke-width="2"/><path d="M268 110 H300" stroke="var(--accent)" stroke-width="2" marker-end={`url(#${id}-arrow)`}/><rect x="314" y="73" width="174" height="76" rx="8" fill="var(--accent-soft)" stroke="var(--line)"/><text x="401" y="103" text-anchor="middle" fill="var(--ink)" font-size="16">Filter + validate</text><text x="401" y="130" text-anchor="middle" fill="var(--muted)" font-size="14">Exact rules in code</text><path d="M498 110 H546" stroke="var(--accent)" stroke-width="2" marker-end={`url(#${id}-arrow)`}/><rect x="560" y="73" width="174" height="76" rx="8" fill="var(--panel)" stroke="var(--line)"/><text x="647" y="103" text-anchor="middle" fill="var(--ink)" font-size="16">Explain + cite</text><text x="647" y="130" text-anchor="middle" fill="var(--muted)" font-size="14">Evaluate grounding</text><path d="M647 159 V231 H588" fill="none" stroke="var(--accent)" stroke-width="2" marker-end={`url(#${id}-arrow)`}/><rect x="296" y="208" width="278" height="84" rx="8" fill="var(--accent-soft)" stroke="var(--line)"/><text x="435" y="239" text-anchor="middle" fill="var(--ink)" font-size="16">Authorized watchlist write</text><text x="435" y="264" text-anchor="middle" fill="var(--muted)" font-size="14">Execute, verify, report outcome</text><text x="380" y="319" text-anchor="middle" fill="var(--muted)" font-size="13">Only enter the write step when the user requests that action.</text></>}
</svg></div><figcaption>{captions[kind]}</figcaption></figure>
