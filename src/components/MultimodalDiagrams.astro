---
interface Props{kind:'alignment'|'fusion'|'evidence'}
const {kind}=Astro.props,id='multimodal-'+kind;
const titles={alignment:'Separate encoders. A compatible comparison space.',fusion:'Let visual features inform a language answer.',evidence:'Keep the source location through every step.'};
const captions={alignment:'Figure 1. Paired training makes image and text representations comparable. At retrieval time, each encoder runs on its own input and similarity ranks candidates. Equal vector length alone does not create this compatibility.',fusion:'Figure 2. One vision-language design maps image features through a projector and combines them with question tokens in a language model. Other architectures use different fusion mechanisms. This diagram describes an image-to-text system, not an image generator.',evidence:'Figure 3. Parsing or recognition creates evidence linked to the original page, region, or time interval. Retrieval selects evidence; answering uses it; verification checks the claim against the linked source. A citation needs to support the associated statement.'};
---
<figure class="diagram"><div class="figure-title"><span class="figure-icon" aria-hidden="true">↗</span>{titles[kind]}</div><div class="diagram-scroll" tabindex="0" role="region" aria-label={titles[kind]}><svg viewBox="0 0 760 280" role="img" aria-labelledby={`${id}-title ${id}-desc`}><title id={`${id}-title`}>{titles[kind]}</title><desc id={`${id}-desc`}>{captions[kind]}</desc><defs><marker id={`${id}-arrow`} markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto"><path d="M0 0 L8 4 L0 8Z" fill="var(--accent)"/></marker></defs>
{kind==='alignment'&&<>{[['Poster','Image encoder','Vector v'],['Query text','Text encoder','Vector t']].map((row,i)=><g>{row.map((label,j)=><g><rect x={20+j*187} y={i?180:28} width="159" height="64" rx="8" fill={j===2?'var(--accent-soft)':'var(--panel)'} stroke="var(--line)"/><text x={99.5+j*187} y={i?218:66} text-anchor="middle" fill="var(--ink)" font-size="16">{label}</text>{j<2&&<path d={`M${184+j*187} ${i?212:60} H${201+j*187}`} stroke="var(--accent)" stroke-width="2" marker-end={`url(#${id}-arrow)`}/>}</g>)}</g>)}<path d="M560 60 H578 V116 H594" fill="none" stroke="var(--accent)" stroke-width="2" marker-end={`url(#${id}-arrow)`}/><path d="M560 212 H578 V160 H594" fill="none" stroke="var(--accent)" stroke-width="2" marker-end={`url(#${id}-arrow)`}/><rect x="607" y="99" width="132" height="80" rx="8" fill="var(--accent-soft)" stroke="var(--line)"/><text x="673" y="131" text-anchor="middle" fill="var(--ink)" font-size="16">Compare</text><text x="673" y="157" text-anchor="middle" fill="var(--muted)" font-size="14">Rank matches</text><text x="290" y="143" text-anchor="middle" fill="var(--muted)" font-size="14">Paired training aligns the two encoders.</text></>}
{kind==='fusion'&&<><rect x="20" y="26" width="174" height="70" rx="8" fill="var(--panel)" stroke="var(--line)"/><text x="107" y="56" text-anchor="middle" fill="var(--ink)" font-size="16">Image features</text><text x="107" y="80" text-anchor="middle" fill="var(--muted)" font-size="14">From vision encoder</text><path d="M201 61 H242" stroke="var(--accent)" stroke-width="2" marker-end={`url(#${id}-arrow)`}/><rect x="256" y="26" width="154" height="70" rx="8" fill="var(--accent-soft)" stroke="var(--line)"/><text x="333" y="67" text-anchor="middle" fill="var(--ink)" font-size="16">Projector</text><path d="M417 61 H482 V99" fill="none" stroke="var(--accent)" stroke-width="2" marker-end={`url(#${id}-arrow)`}/><rect x="428" y="112" width="162" height="80" rx="8" fill="var(--accent-soft)" stroke="var(--line)"/><text x="509" y="145" text-anchor="middle" fill="var(--ink)" font-size="16">Language model</text><text x="509" y="169" text-anchor="middle" fill="var(--muted)" font-size="14">Use both inputs</text><rect x="20" y="176" width="269" height="64" rx="8" fill="var(--panel)" stroke="var(--line)"/><text x="154.5" y="214" text-anchor="middle" fill="var(--ink)" font-size="16">Question → text tokens</text><path d="M297 208 H360 V152 H415" fill="none" stroke="var(--accent)" stroke-width="2" marker-end={`url(#${id}-arrow)`}/><path d="M597 152 H630" stroke="var(--accent)" stroke-width="2" marker-end={`url(#${id}-arrow)`}/><text x="691" y="157" text-anchor="middle" fill="var(--ink)" font-size="16">Text answer</text><text x="380" y="270" text-anchor="middle" fill="var(--muted)" font-size="13">The connector must be learned; image features are not automatically text tokens.</text></>}
{kind==='evidence'&&<>{[['Original media','Identity + access'],['Extract / encode','Text, features, regions'],['Retrieve evidence','Keep source pointers'],['Answer + verify','Check each claim']].map(([title,sub],j)=><g><rect x={20+j*187} y="56" width="159" height="86" rx="8" fill={j===2?'var(--accent-soft)':'var(--panel)'} stroke="var(--line)"/><text x={99.5+j*187} y="91" text-anchor="middle" fill="var(--ink)" font-size="15">{title}</text><text x={99.5+j*187} y="116" text-anchor="middle" fill="var(--muted)" font-size="13">{sub}</text>{j<3&&<path d={`M${184+j*187} 99 H${201+j*187}`} stroke="var(--accent)" stroke-width="2" marker-end={`url(#${id}-arrow)`}/>}</g>)}<path d="M660 153 V205 H100 V153" fill="none" stroke="var(--accent)" stroke-width="2" stroke-dasharray="5 4" marker-end={`url(#${id}-arrow)`}/><text x="380" y="189" text-anchor="middle" fill="var(--muted)" font-size="14">Follow citations back to the original evidence.</text><text x="380" y="244" text-anchor="middle" fill="var(--muted)" font-size="14">Document: page + box · Audio / video: source time interval</text></>}
</svg></div><figcaption>{captions[kind]}</figcaption></figure>
