---
interface Props{kind:'service'|'release'|'retry'}
const {kind}=Astro.props,id='ops-'+kind;
const titles={service:'Deploy the service around the model.',release:'Expose a change gradually. Keep a way back.',retry:'A retry shares the original request deadline.'};
const captions={service:'Figure 1. The backend owns credentials, authorization, validation, and coordination. Databases and external services remain separate dependencies with their own failure modes.',release:'Figure 2. A tested artifact reaches staging, then limited production traffic. Observations determine whether to expand, pause, or return future traffic to a compatible earlier release.',retry:'Figure 3. A transient failure costs 400 ms, backoff costs 200 ms, and the candidate retry needs 900 ms. It completes in 1500 ms under a 2400 ms deadline, but exceeds a 1200 ms deadline.'};
const arrow=`url(#${id}-arrow)`;
const boxes=kind==='service'?[['Client','Request + identity'],['Backend API','Policy + orchestration'],['Dependencies','Model + search + tools'],['Response','Validate + explain']]:kind==='release'?[['Build + test','Versioned artifact'],['Staging','Integration + load'],['Canary','Limited live traffic'],['Review evidence','Expand / pause / undo']]:[['Attempt 1','503 · 400 ms'],['Backoff','Wait · 200 ms'],['Attempt 2','200 · 900 ms'],['Final outcome','1500 ms total']];
---
<figure class="diagram"><div class="figure-title"><span class="figure-icon" aria-hidden="true">↗</span>{titles[kind]}</div><div class="diagram-scroll" tabindex="0" role="region" aria-label={titles[kind]}><svg viewBox="0 0 760 270" role="img" aria-labelledby={`${id}-title ${id}-desc`}><title id={`${id}-title`}>{titles[kind]}</title><desc id={`${id}-desc`}>{captions[kind]}</desc><defs><marker id={`${id}-arrow`} markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto"><path d="M0 0 L8 4 L0 8Z" fill="var(--accent)"/></marker></defs>
{boxes.map(([label,sub],i)=><g><rect x={18+i*188} y="45" width="160" height="86" rx="8" fill={i===2?'var(--accent-soft)':'var(--panel)'} stroke="var(--line)"/><text x={98+i*188} y="79" text-anchor="middle" fill="var(--ink)" font-size="15">{label}</text><text x={98+i*188} y="106" text-anchor="middle" fill="var(--muted)" font-size="12">{sub}</text>{i<3&&<path d={`M${181+i*188} 88 H${199+i*188}`} stroke="var(--accent)" stroke-width="2" marker-end={arrow}/>}</g>)}
{kind==='service'&&<><path d="M286 141 V178 H474 V141" fill="none" stroke="var(--accent)" stroke-width="2"/><text x="380" y="211" text-anchor="middle" fill="var(--ink)" font-size="15">Persistent state · Secret store · Queue for long-running jobs</text><text x="380" y="247" text-anchor="middle" fill="var(--muted)" font-size="13">Record version, latency, failures, and cost across the request path.</text></>}
{kind==='release'&&<><path d="M662 142 V204 H98 V143" fill="none" stroke="var(--accent)" stroke-width="2" stroke-dasharray="5 4" marker-end={arrow}/><text x="380" y="181" text-anchor="middle" fill="var(--ink)" font-size="14">Failure → restore compatible version → diagnose → retest</text><text x="380" y="249" text-anchor="middle" fill="var(--muted)" font-size="13">Rollback changes future traffic; it does not undo past user effects.</text></>}
{kind==='retry'&&<><path d="M98 142 V174 H662 V142" fill="none" stroke="var(--accent)" stroke-width="2"/><text x="380" y="210" text-anchor="middle" fill="var(--ink)" font-size="15">2400 ms budget: completes · 1200 ms budget: times out</text><text x="380" y="245" text-anchor="middle" fill="var(--muted)" font-size="13">More attempts consume time and resources. They do not repair a bad answer.</text></>}
</svg></div><figcaption>{captions[kind]}</figcaption></figure>
